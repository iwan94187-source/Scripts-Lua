local FLY_SPEED = 64
local FLY_FORCE = 40000

local bodyVelocity = nil
local bodyGyro = nil
local flyConnection = nil

-- دالة إيقاف الطيران وتنظيف الأجسام الفيزيائية
local function stopFlying()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
	end
end

local function startFlying()
	stopFlying()

	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera

	if not rootPart or not humanoid or humanoid.Health <= 0 then return end

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "FlyVelocity"
	bodyVelocity.MaxForce = Vector3.new(FLY_FORCE, FLY_FORCE, FLY_FORCE)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = rootPart

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "FlyGyro"
	bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
	bodyGyro.P = 10000
	bodyGyro.D = 500
	bodyGyro.CFrame = rootPart.CFrame
	bodyGyro.Parent = rootPart

	humanoid.PlatformStand = true

	flyConnection = runService.RenderStepped:Connect(function()
		if not flyState or not char or not rootPart or humanoid.Health <= 0 then
			stopFlying()
			return
		end

		bodyGyro.CFrame = camera.CFrame

		local moveDir = humanoid.MoveDirection

		if moveDir.Magnitude > 0 then
			-- 🎯 تحويل اتجاه الحركة ليتضمن المحور Y كاملاً بناءً على زاوية توجيه الكاميرا
			local camCFrame = camera.CFrame

			-- اتجاه الأمام والخلف من الكاميرا (يشمل Y)
			local forward = camCFrame.LookVector
			-- اتجاه اليمين واليسار الأفقي
			local right = camCFrame.RightVector

			-- تحويل مدخلات الحركة الكلاسيكية إلى اتجاه الكاميرا الحقيقي
			local localMove = camCFrame:VectorToObjectSpace(moveDir)
			local targetDirection = (forward * -localMove.Z) + (right * localMove.X)

			if targetDirection.Magnitude > 0 then
				bodyVelocity.Velocity = targetDirection.Unit * FLY_SPEED
			end
		else
			bodyVelocity.Velocity = Vector3.zero
		end
	end)
end

runService.Heartbeat:Connect(function()
	if flyState then
		if not bodyVelocity or not bodyVelocity.Parent then
			startFlying()
		end
	else
		if bodyVelocity then
			stopFlying()
		end
	end
	if antiTrapState then 
		local folderMap = workspace:FindFirstChild("CurrentMap")
