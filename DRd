local activeTrajectories = {}

local function setupSmartAutoDodge(ball)
	if not ball or not ball:IsA("BasePart") then return end

	-- 1. إنشاء المربع (Zone Part)
	local hitbox = Instance.new("Part")
	hitbox.Name = "BallTrajectoryZone"
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.Transparency = 1
	hitbox.Material = Enum.Material.ForceField
	hitbox.Color = Color3.fromRGB(255, 0, 0)
	hitbox.Parent = workspace

	table.insert(activeTrajectories, hitbox)

	local zoneSize = 25         -- نطاق المربع ثابت 15 متر حول الكرة
	local maxTeleportOffset = 25  -- أقصى مدى للنقل
	local minSafeDistance = 6     -- الحد الأدنى لمنع الالتصاق
	local wallBuffer = 3.5        -- هامش أمان لمنع النقل داخل/خلف الجدار
	local cooldown = false
	local updateConnection = nil

	-- 🧠 0. فحص أمان النقطة من كرات أخرى
	local function isPositionInsideOtherZone(targetPos)
		for _, zone in ipairs(activeTrajectories) do
			if zone ~= hitbox and zone.Parent then
				local relPos = zone.CFrame:PointToObjectSpace(targetPos)
				local halfSize = zone.Size / 2

				if math.abs(relPos.X) <= halfSize.X and 
					math.abs(relPos.Y) <= halfSize.Y and 
					math.abs(relPos.Z) <= halfSize.Z then
					return true
				end
			end
		end
		return false
	end

	-- 🔒 فحص الأمان الشامل: تأكيد الخلو من الجدران والكرات الأخرى
	local function isDestinationSafe(startPos, targetPos, rayParams)
		-- أ. فحص المسار المباشر من موقع اللاعب إلى الهدف
		local pathRay = workspace:Raycast(startPos, targetPos - startPos, rayParams)
		if pathRay and pathRay.Instance and pathRay.Instance.CanCollide then
			return false
		end

		-- ب. فحص الخطر من زونات الكرات الأخرى
		if isPositionInsideOtherZone(targetPos) then
			return false
		end

		-- ج. فحص محيطي حول النقطة لمنع الالتصاق بحافة الجدران
		local sphereCheck = workspace:Spherecast(targetPos, 1.5, Vector3.new(0, -0.1, 0), rayParams)
		if sphereCheck and sphereCheck.Instance and sphereCheck.Instance.CanCollide then
			return false
		end

		return true
	end

	-- 2. المراقبة المستمرة داخل Heartbeat
	updateConnection = runService.Heartbeat:Connect(function()
		if not ball or not ball.Parent or not ball:IsDescendantOf(workspace) then
			if updateConnection then updateConnection:Disconnect() end
			if hitbox then hitbox:Destroy() end
			local index = table.find(activeTrajectories, hitbox)
			if index then table.remove(activeTrajectories, index) end
			return
		end

		hitbox.Size = Vector3.new(zoneSize, zoneSize, zoneSize)
		hitbox.CFrame = CFrame.new(ball.Position)

		if AutoDodgeState and not cooldown then
			local char = LocalPlayer.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")

			if rootPart and humanoid and humanoid.Health > 0 then
				local relPos = hitbox.CFrame:PointToObjectSpace(rootPart.Position)
				local halfSize = hitbox.Size / 2

				local isInsideZone = math.abs(relPos.X) <= halfSize.X and 
					math.abs(relPos.Y) <= halfSize.Y and 
					math.abs(relPos.Z) <= halfSize.Z

				if isInsideZone then
					local ballPos = ball.Position
					local myPos = rootPart.Position
					local velocity = ball.AssemblyLinearVelocity
					local direction = velocity.Magnitude > 2 and velocity.Unit or -rootPart.CFrame.LookVector

					local raycastParams = RaycastParams.new()
					raycastParams.FilterDescendantsInstances = {char, ball, hitbox}
					raycastParams.FilterType = Enum.RaycastFilterType.Exclude
					raycastParams.IgnoreWater = true
					raycastParams.RespectCanCollide = true

					local targetPosition = nil

					-- حساب المتجهات الجانبية والخلفية
					local backDir = -direction
					local rightDir = Vector3.new(-direction.Z, 0, direction.X).Unit
					local leftDir = -rightDir

					-- 🎯 ترتيب الأولوية الجديد: اليمين -> اليسار -> القطريات -> الخلف كحل أخير
					local candidatesDirections = {
						rightDir,                  -- 1. اليمين
						leftDir,                   -- 2. اليسار
						(backDir + rightDir).Unit, -- 3. قطري يمين
						(backDir + leftDir).Unit,  -- 4. قطري يسار
						backDir                    -- 5. خلف الكرة (عند انسداد الخيارات السابقة)
					}

					-- التجربة بالترتيب واختيار أول نقطة آمنة
					for _, dir in ipairs(candidatesDirections) do
						local rayResult = workspace:Raycast(ballPos, dir * maxTeleportOffset, raycastParams)
						local testPos = nil

						if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
							local hitDist = rayResult.Distance
							if hitDist > minSafeDistance then
								testPos = ballPos + (dir * (hitDist - wallBuffer))
							end
						else
							testPos = ballPos + (dir * maxTeleportOffset)
						end

						-- فحص سلامة النقطة المستهدفة
						if testPos then
							local checkPos = Vector3.new(testPos.X, myPos.Y, testPos.Z)
							if isDestinationSafe(myPos, checkPos, raycastParams) then
								targetPosition = checkPos
								break
							end
						end
					end

					-- 🚀 تنفيذ النقل اللحظي عند العثور على المسار الآمن
					if targetPosition then
						cooldown = true

						rootPart.CFrame = CFrame.new(targetPosition, targetPosition + rootPart.CFrame.LookVector)
						rootPart.AssemblyLinearVelocity = Vector3.zero

						task.delay(0.15, function()
							cooldown = false
						end)
					end
				end
			end
		end
	end)

	ball.Destroying:Connect(function()
		if updateConnection then updateConnection:Disconnect() end
		if hitbox then hitbox:Destroy() end
		local index = table.find(activeTrajectories, hitbox)
		if index then table.remove(activeTrajectories, index) end
	end)
end

