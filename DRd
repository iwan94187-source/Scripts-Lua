local function setupBallTrajectory(ball)
	if not ball:IsA("BasePart") then return end

	-- إنشاء مجسم الخط (Laser Line)
	local linePart = Instance.new("Part")
	linePart.Name = "TrajectoryLine"
	linePart.Anchored = true
	linePart.CanCollide = false
	linePart.Material = Enum.Material.ForceField
	linePart.Color = Color3.fromRGB(255, 50, 50) -- لون أحمر نيون
	linePart.Transparency = 1
	linePart.Size = Vector3.new(0.6, 0.6, 1)
	linePart.Parent = workspace

	local lineLength = 150 -- طول الخط
	local extraSafetyBuffer = 10 -- مسافة التأمين الإضافية بالـ Studs
	local updateConnection = nil

	updateConnection = runService.Heartbeat:Connect(function()
		if not ball or not ball.Parent or not ball:IsDescendantOf(workspace) then
			if updateConnection then updateConnection:Disconnect() end
			if linePart then linePart:Destroy() end
			return
		end

		-- 🧠 فحص شرط التفعيل الرئيسي هنا داخل Heartbeat
		if dodgeAuraState then
			local velocity = ball.AssemblyLinearVelocity

			-- إذا كانت الكرة تتحرك
			if velocity.Magnitude > 1 then
				local direction = velocity.Unit

				-- ربط موقع واتجاه الخط بالكرة
				local lineCenter = ball.Position + (direction * (lineLength / 2))
				linePart.Size = Vector3.new(0.6, 0.6, lineLength)
				linePart.CFrame = CFrame.lookAt(lineCenter, lineCenter + direction)

				-- حساب مسافة الأمان أوتوماتيكياً
				local ballRadius = math.max(ball.Size.X, ball.Size.Y, ball.Size.Z) / 2
				local dynamicSafetyRadius = ballRadius + extraSafetyBuffer

				local lineCFrame = linePart.CFrame
				local lineForward = lineCFrame.LookVector

				-- فحص موقع كل لاعب بالنسبة لهالة الأمان
				for _, plr in ipairs(Players:GetPlayers()) do
					local char = plr.Character
					local rootPart = char and char:FindFirstChild("HumanoidRootPart")
					local humanoid = char and char:FindFirstChildOfClass("Humanoid")

					if rootPart and humanoid and humanoid.Health > 0 then
						local playerPos = rootPart.Position
						local vecToPlayer = playerPos - lineCenter

						-- حساب المسافة الطولية والعمودية
						local forwardDist = math.abs(vecToPlayer:Dot(lineForward))
						local projection = vecToPlayer:Dot(lineForward) * lineForward
						local perpendicularVec = vecToPlayer - projection
						local perpendicularDist = perpendicularVec.Magnitude

						-- إذا دخل اللاعب في نطاق هالة الأمان
						if forwardDist <= (lineLength / 2) and perpendicularDist <= dynamicSafetyRadius then
							local pushDir = perpendicularDist > 0.1 and perpendicularVec.Unit or lineCFrame.RightVector

							local pushSpeed = 60
							local upSpeed = 15

							rootPart.AssemblyLinearVelocity = (pushDir * pushSpeed) + Vector3.new(0, upSpeed, 0)
						end
					end
				end
			else
				-- إخفاء الخط إذا كانت الكرة متوقفة
				linePart.Transparency = 1
			end
		else
			-- إذا كان safeLineState مساوياً لـ false، يتم إخفاء الخط وتجاهل الدفع
			linePart.Transparency = 1
		end
	end)

	-- تنظيف الخط عند حذف الكرة
	ball.Destroying:Connect(function()
		if updateConnection then updateConnection:Disconnect() end
		if linePart then linePart:Destroy() end
	end)
end

