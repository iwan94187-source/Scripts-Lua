runService.Heartbeat:Connect(function(deltaTime)
	if speedState then 
		if tonumber(speedBox.Text) then 
			local spd = UpFolder:FindFirstChild("Speed")
			if spd then 
				spd.Value=speedBox.Text
			end
		end
	end

	if dashState then 
		if tonumber(dashBox.Text) then 
			local dsh = UpFolder:FindFirstChild("Dashes")
			if dsh then 
				dsh.Value=dashBox.Text
			end
		end
	end

	if jumpState then 
		if tonumber(jumpBox.Text) then 
			local jp = UpFolder:FindFirstChild("Jump")
			if jp then 
				jp.Value=jumpBox.Text
			end
		end
	end

	if orbState then 
		local character = player.Character
		if not character then return end

		local hrp = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChild("Humanoid")

		if not hrp or not humanoid or humanoid.Health <= 0 then return end

		local totalPushVector = Vector3.zero
		local activeBallsCount = 0

		-- فحص جميع الكرات الموجودة داخل المجلد
		for _, ball in ipairs(ballsFolder:GetChildren()) do
			if ball:IsA("BasePart") then
				local distance = (hrp.Position - ball.Position).Magnitude

				-- إذا دخلت الكرة نطاق الـ Hitbox
				if distance < HITBOX_RADIUS and distance > 0 then
					activeBallsCount += 1

					-- حساب اتجاه الهروب بعيداً عن الكرة (Direction)
					local pushDirection = (hrp.Position - ball.Position).Unit

					-- حساب مقدار التداخل/الاقتراب (كلما اقتربت الكرة، زاد الدفع)
					local overlap = (HITBOX_RADIUS - distance) / HITBOX_RADIUS

					-- إضافة المتجه المحسوب إلى المتجه الإجمالي
					totalPushVector = totalPushVector + (pushDirection * (overlap * PUSH_FORCE))
				end
			end
		end

		-- تطبيق قوة الهروب إذا كانت هناك كرات قريبة
		if activeBallsCount > 0 and totalPushVector.Magnitude > 0 then
			-- دمج التأثير بشكل سلس دون إلغاء حركة اللاعب الأساسية
			local currentVelocity = hrp.AssemblyLinearVelocity

			-- تجميع دفع الكرات مع الحفاظ على الحركة الرأسية (القفز / الجاذبية)
			local targetVelocity = Vector3.new(
				currentVelocity.X + totalPushVector.X * deltaTime * 10,
				currentVelocity.Y, -- الحفاظ على الجاذبية طبيعية
				currentVelocity.Z + totalPushVector.Z * deltaTime * 10
			)

			-- تحديد حد أقصى للسرعة للحد من الطيران المفاجئ
			if targetVelocity.Magnitude > MAX_ESCAPE_VELOCITY then
				targetVelocity = targetVelocity.Unit * MAX_ESCAPE_VELOCITY
			end

			hrp.AssemblyLinearVelocity = targetVelocity
		end
	end

	if voidState then 
		local map = workspace:FindFirstChild("CurrentMap")
		if map then 
			for _, item in ipairs(map:GetChildren()) do 
				if item.Name == "Wall" or item.Name == "WALL" then 
					item.CanCollide=false
				end
			end
		end
	end
	
end)
