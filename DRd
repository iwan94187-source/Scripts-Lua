local activeTrajectories = {}

local function setupSmartAutoDodge(ball)
	if not ball or not ball:IsA("BasePart") then return end

	-- 1. إنشاء الأنبوب (Zone Part)
	local hitbox = Instance.new("Part")
	hitbox.Name = "BallTrajectoryZone"
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.Transparency = 1
	hitbox.Material = Enum.Material.ForceField
	hitbox.Color = Color3.fromRGB(255, 0, 0)
	hitbox.Parent = workspace

	table.insert(activeTrajectories, hitbox)

	local frontZoneLength = 15    -- طول الأنبوب أمام الكرة (15 Studs)
	local extraWidthBuffer = 6    -- عرض الأنبوب
	local maxTeleportOffset = 15  -- أقصى مدى للنقل (15 Studs)
	local minSafeDistance = 5     -- الحد الأدنى المسموح به لخلف الكرة (5 Studs)
	local wallBuffer = 2.5        -- مسافة أمان قبل الجدار مباشرة
	local cooldown = false
	local updateConnection = nil

	-- 🧠 0. فحص أمان النقطة: هل تقع داخل أنبوب كرة أخرى؟
	local function isPositionInsideOtherZone(targetPos)
		for _, zone in ipairs(activeTrajectories) do
			if zone ~= hitbox and zone.Parent then
				local relPos = zone.CFrame:PointToObjectSpace(targetPos)
				local halfSize = zone.Size / 2

				-- إذا كانت النقطة داخل أبعاد أنبوب كرة أخرى
				if math.abs(relPos.X) <= halfSize.X and 
					math.abs(relPos.Y) <= halfSize.Y and 
					math.abs(relPos.Z) <= halfSize.Z then
					return true -- النقطة خطرة (داخل مسار كرة أخرى)
				end
			end
		end
		return false -- النقطة آمنة
	end

	-- 2. المراقبة المستمرة وحساب الأبعاد داخل Heartbeat
	updateConnection = runService.Heartbeat:Connect(function()
		if not ball or not ball.Parent or not ball:IsDescendantOf(workspace) then
			if updateConnection then updateConnection:Disconnect() end
			if hitbox then hitbox:Destroy() end
			local index = table.find(activeTrajectories, hitbox)
			if index then table.remove(activeTrajectories, index) end
			return
		end

		local velocity = ball.AssemblyLinearVelocity

		if velocity.Magnitude > 2 then
			local direction = velocity.Unit
			local ballDiameter = math.max(ball.Size.X, ball.Size.Y, ball.Size.Z)
			local zoneWidth = ballDiameter + extraWidthBuffer

			-- تعيين حجم وموقع الأنبوب أمام الكرة
			hitbox.Size = Vector3.new(zoneWidth, zoneWidth, frontZoneLength)
			local centerPos = ball.Position + (direction * (frontZoneLength / 2))
			hitbox.CFrame = CFrame.lookAt(centerPos, centerPos + direction)

			-- المراقبة عند دخول اللاعب في النطاق
			if AutoDodgeState and not cooldown then
				local char = LocalPlayer.Character
				local rootPart = char and char:FindFirstChild("HumanoidRootPart")
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")

				if rootPart and humanoid and humanoid.Health > 0 then
					local relPos = hitbox.CFrame:PointToObjectSpace(rootPart.Position)
					local halfSize = hitbox.Size / 2

					local isInsideZone = math.abs(relPos.X) <= halfSize.X and 
						math.abs(relPos.Y) <= halfSize.Y and 
						math.abs(relPos.Z) <= halfSize.Z

					if isInsideZone then
						local ballPos = ball.Position
						local myPos = rootPart.Position

						-- إعدادات الـ Raycast
						local raycastParams = RaycastParams.new()
						raycastParams.FilterDescendantsInstances = {char, ball, hitbox}
						raycastParams.FilterType = Enum.RaycastFilterType.Exclude
						raycastParams.IgnoreWater = true
						raycastParams.RespectCanCollide = true

						local targetPosition = nil
						local isBlocked = false

						-- -------------------------------------------------------------
						-- 🧠 1. فحص الجدار الأمامي (أمام الكرة)
						-- -------------------------------------------------------------
						local frontRayResult = workspace:Raycast(ballPos, direction * 5, raycastParams)
						if frontRayResult and frontRayResult.Instance and frontRayResult.Instance.CanCollide then
							isBlocked = true
						end

						-- -------------------------------------------------------------
						-- 🧠 2. فحص المسار الخلفي لحساب نقطة النقل الأساسية (خلف الكرة)
						-- -------------------------------------------------------------
						if not isBlocked then
							local backRayResult = workspace:Raycast(ballPos, -direction * maxTeleportOffset, raycastParams)

							if backRayResult and backRayResult.Instance and backRayResult.Instance.CanCollide then
								local hitDistance = backRayResult.Distance
								if hitDistance < minSafeDistance then
									isBlocked = true -- الجدار قريب جداً
								else
									local safeDist = math.max(minSafeDistance, hitDistance - wallBuffer)
									targetPosition = ballPos - (direction * safeDist)
								end
							else
								targetPosition = ballPos - (direction * maxTeleportOffset)
							end
						end

						-- -------------------------------------------------------------
						-- 🧠 3. فحص الجدار بين موقعك ونقطة النقل الخلفية
						-- -------------------------------------------------------------
						if targetPosition and not isBlocked then
							local pathToTarget = targetPosition - myPos
							local pathRay = workspace:Raycast(myPos, pathToTarget, raycastParams)

							if pathRay and pathRay.Instance and pathRay.Instance.CanCollide then
								isBlocked = true
							end
						end

						-- -------------------------------------------------------------
						-- 🛑 4. فحص الخطر الرئيسي: هل النقطة خلف الكرة تقع داخل كرة أخرى؟
						-- -------------------------------------------------------------
						if targetPosition and not isBlocked then
							if isPositionInsideOtherZone(targetPosition) then
								isBlocked = true -- إلغاء النقل للخلف لأن الكرة الثانية متواجدة هناك!
							end
						end

						-- -------------------------------------------------------------
						-- 🛡️ 5. خطة الطوارئ: النقل العكسي لوراء اللاعب بشرط ألا يكون داخل كرة أخرى
						-- -------------------------------------------------------------
						if isBlocked or not targetPosition then
							local playerBackDir = -rootPart.CFrame.LookVector
							local fallbackRay = workspace:Raycast(myPos, playerBackDir * maxTeleportOffset, raycastParams)

							local fallbackPos = nil
							if fallbackRay and fallbackRay.Instance and fallbackRay.Instance.CanCollide then
								local hitDist = fallbackRay.Distance
								if hitDist > wallBuffer then
									fallbackPos = myPos + (playerBackDir * (hitDist - wallBuffer))
								end
							else
								fallbackPos = myPos + (playerBackDir * maxTeleportOffset)
							end

							-- التأكد من أن موقع الطوارئ خالٍ أيضاً من مسارات الكرات
							if fallbackPos and not isPositionInsideOtherZone(fallbackPos) then
								targetPosition = fallbackPos
							else
								targetPosition = nil -- إلغاء النقل تماماً إذا كانت كل الخيارات خطرة
							end
						end

						-- 🚀 6. تنفيذ النقل النهائي الآمن
						if targetPosition then
							cooldown = true
							rootPart.CFrame = CFrame.new(targetPosition, targetPosition + rootPart.CFrame.LookVector)
							rootPart.AssemblyLinearVelocity = Vector3.zero

							task.delay(0.35, function()
								cooldown = false
							end)
						end
					end
				end
			end
		else
			hitbox.Size = Vector3.new(0.1, 0.1, 0.1)
		end
	end)

	ball.Destroying:Connect(function()
		if updateConnection then updateConnection:Disconnect() end
		if hitbox then hitbox:Destroy() end
		local index = table.find(activeTrajectories, hitbox)
		if index then table.remove(activeTrajectories, index) end
	end)
end

