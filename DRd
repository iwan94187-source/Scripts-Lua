local extraSafetyBuffer = 12 -- مسافة الأمان بالـ Studs
local pushSpeed = 80         -- قوة الدفع الجانبي
local upSpeed = 20           -- قوة الدفع للأعلى

-- دالة معالجة القطعة ومراقبتها طالما هي موجودة
local function trackAndPush(part)
	if not part:IsA("BasePart") then return end

	local targetNames = { ["TrajectoryLine"] = true, ["BallTrajectoryZone"] = true }
	if not targetNames[part.Name] then return end

	local connection
	connection = runService.Heartbeat:Connect(function()
		-- إيقاف المتابعة إذا تم حذف القطعة أو إغلاق الميزة
		if not part or not part.Parent then
			if connection then connection:Disconnect() end
			return
		end

		if not DodgeAuraState then return end

		local char = LocalPlayer.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")

		if not rootPart or not humanoid or humanoid.Health <= 0 then return end

		local partSize = part.Size
		local partCFrame = part.CFrame
		local lineForward = partCFrame.LookVector
		local lineCenter = part.Position
		local lineLength = partSize.Z

		local dynamicSafetyRadius = (math.max(partSize.X, partSize.Y) / 2) + extraSafetyBuffer

		local playerPos = rootPart.Position
		local vecToPlayer = playerPos - lineCenter

		local forwardDist = math.abs(vecToPlayer:Dot(lineForward))
		local projection = vecToPlayer:Dot(lineForward) * lineForward
		local perpendicularVec = vecToPlayer - projection
		local perpendicularDist = perpendicularVec.Magnitude

		-- إذا دخلت في نطاق القطعة يتم دفعك فوراً
		if forwardDist <= (lineLength / 2) and perpendicularDist <= dynamicSafetyRadius then
			local pushDir = perpendicularDist > 0.1 and perpendicularVec.Unit or partCFrame.RightVector
			rootPart.AssemblyLinearVelocity = (pushDir * pushSpeed) + Vector3.new(0, upSpeed, 0)
		end
	end)

	-- تنظيف الاتصال عند حذف القطعة
	part.Destroying:Connect(function()
		if connection then connection:Disconnect() end
	end)
end

-- 1. فحص العناصر الموجودة بالداخل مسبقاً
for _, item in ipairs(workspace:GetDescendants()) do
	task.spawn(trackAndPush, item)
