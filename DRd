local activeTrajectories = {}

local function setupSmartAutoDodge(ball)
	if not ball or not ball:IsA("BasePart") then return end

	local hitbox = Instance.new("Part")
	hitbox.Name = "BallTrajectoryZone"
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.Transparency = 1
	hitbox.Material = Enum.Material.ForceField
	hitbox.Color = Color3.fromRGB(255, 0, 0)
	hitbox.Parent = workspace

	local zoneSize = 15 
	local safeEdgeDistance = 16 
	local corridorWidth = 8 
	local corridorLength = 30 
	local cooldown = false
	local updateConnection = nil

	local zoneData = {
		part = hitbox,
		ball = ball,
		getCorridorCFAndSize = function()
			local vel = ball.AssemblyLinearVelocity
			if vel.Magnitude > 2 then
				local dir = vel.Unit
				local center = ball.Position + (dir * (corridorLength / 2))
				return CFrame.lookAt(center, center + dir), Vector3.new(corridorWidth, corridorWidth, corridorLength)
			end
			return nil, nil
		end
	}

	table.insert(activeTrajectories, zoneData)

	-- 🧠 فحص آمن سريع جداً
	local function isPositionSafe(targetPos, char)
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {char, ball, hitbox}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.RespectCanCollide = true

			local pathVector = targetPos - root.Position
			local wallRay = workspace:Raycast(root.Position, pathVector, rayParams)
			if wallRay and wallRay.Instance and wallRay.Instance.CanCollide then
				return false
			end
		end

		for _, data in ipairs(activeTrajectories) do
			if data.part and data.part.Parent then
				local relPosData = data.part.CFrame:PointToObjectSpace(targetPos)
				local halfSize = data.part.Size / 2
				if math.abs(relPosData.X) <= halfSize.X and 
					math.abs(relPosData.Y) <= halfSize.Y and 
					math.abs(relPosData.Z) <= halfSize.Z then
					return false
				end

				local cframe, size = data.getCorridorCFAndSize()
				if cframe and size then
					local relCorridor = cframe:PointToObjectSpace(targetPos)
					local halfCorridor = size / 2
					if math.abs(relCorridor.X) <= halfCorridor.X and 
						math.abs(relCorridor.Y) <= halfCorridor.Y and 
						math.abs(relCorridor.Z) <= halfCorridor.Z then
						return false
					end
				end
			end
		end

		return true
	end

	-- ⚡ جلب سريع جداً لأول نقطة حافة مجهزة (8 اتجاهات رئيسية فقط)
	local angles = {0, 0.785, 1.57, 2.35, 3.14, 3.92, 4.71, 5.49} -- زوايا جاهزة بالـ Radian لتوفير المعالجة
	local function getFastSafePosition(centerBall, char)
		local ballPos = centerBall.Position
		for i = 1, #angles do
			local angle = angles[i]
			local candidatePos = Vector3.new(
				ballPos.X + (math.cos(angle) * safeEdgeDistance),
				ballPos.Y,
				ballPos.Z + (math.sin(angle) * safeEdgeDistance)
			)

			if isPositionSafe(candidatePos, char) then
				return candidatePos
			end
		end
		return nil
	end

	-- 2. المراقبة والتحديث السريع
	updateConnection = runService.Heartbeat:Connect(function()
		if not ball or not ball.Parent or not ball:IsDescendantOf(workspace) then
			if updateConnection then updateConnection:Disconnect() end
			if hitbox then hitbox:Destroy() end
			for i, data in ipairs(activeTrajectories) do
				if data.part == hitbox then
					table.remove(activeTrajectories, i)
					break
				end
			end
			return
		end

		hitbox.Size = Vector3.new(zoneSize, zoneSize, zoneSize)
		hitbox.CFrame = CFrame.new(ball.Position)

		if AutoDodgeState and not cooldown then
			local char = LocalPlayer.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")

			if rootPart and humanoid and humanoid.Health > 0 then
				local relPos = hitbox.CFrame:PointToObjectSpace(rootPart.Position)
				local halfSize = hitbox.Size / 2

				-- تحقق سريع من الدخول للنطاق
				if math.abs(relPos.X) <= halfSize.X and 
					math.abs(relPos.Y) <= halfSize.Y and 
					math.abs(relPos.Z) <= halfSize.Z then

					cooldown = true -- إيقاف فوري لتفادي التكرار اللحظي

					task.spawn(function()
						local targetPosition = getFastSafePosition(ball, char)

						-- البحث في باقي الكرات بسرعة إن لم يجد في هذه الكرة
						if not targetPosition then
							for _, data in ipairs(activeTrajectories) do
								if data.ball and data.ball ~= ball and data.ball.Parent then
									targetPosition = getFastSafePosition(data.ball, char)
									if targetPosition then break end
								end
							end
						end

						-- 🚀 تنفيذ النقل اللحظي
						if targetPosition then
							rootPart.CFrame = CFrame.new(
								targetPosition.X,
								rootPart.Position.Y,
								targetPosition.Z
							) * (rootPart.CFrame - rootPart.CFrame.Position)

							rootPart.AssemblyLinearVelocity = Vector3.zero
						end

						task.wait(0.2) -- تقليل الـ Cooldown للاستجابة للأخطار المتتالية
						cooldown = false
					end)
				end
			end
		end
	end)

	ball.Destroying:Connect(function()
		if updateConnection then updateConnection:Disconnect() end
		if hitbox then hitbox:Destroy() end
		for i, data in ipairs(activeTrajectories) do
			if data.part == hitbox then
				table.remove(activeTrajectories, i)
				break
			end
		end
	end)
end

