-- 🛠️ تعديل: حماية الفيزياء ومنع التكرار غير المنتهي
local function setupSeatPhysics(seat)
	if currentSeat == seat and linearVelocity then return end -- منع إعادة الإنشاء إذا كانت موجودة مسبقاً

	currentSeat = seat

	if not attachment or attachment.Parent ~= seat then
		if attachment then attachment:Destroy() end
		attachment = Instance.new("Attachment")
		attachment.Name = "CustomVehicleDrive"
		attachment.Parent = seat
	end

	if not linearVelocity or linearVelocity.Parent ~= seat then
		if linearVelocity then linearVelocity:Destroy() end
		linearVelocity = Instance.new("LinearVelocity")
		linearVelocity.Attachment0 = attachment
		linearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		linearVelocity.MaxAxesForce = Vector3.new(300000, 0, 300000)
		linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
		linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
		linearVelocity.Parent = seat
	end

	touchZone.Active = true
	ScreenGui.Enabled = true
end

local function clearSeatPhysics()
	currentSpeed = 0
	resetTouch()

	if attachment then attachment:Destroy() attachment = nil end
	if linearVelocity then linearVelocity:Destroy() linearVelocity = nil end

	currentSeat = nil

	touchZone.Active = false 
	ScreenGui.Enabled = false
end

