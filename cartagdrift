-- 🛠️ تعديل: التحقق الدقيق من الاصبع المسؤول عن الحركة فقط
touchZone.InputBegan:Connect(function(input)
	if controleState and currentSeat and not isTouching then
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			isTouching = true
			activeTouchInput = input -- تسجيل الأصبع الحالي

			local pos = input.Position
			touchStartPos = Vector2.new(pos.X, pos.Y)

			outerRing.Position = UDim2.new(0, pos.X, 0, pos.Y)
			innerKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
			outerRing.Visible = true
		end
	end
end)

touchZone.InputChanged:Connect(function(input)
	if controleState and isTouching then
		-- التفاعل فقط مع نفس الأصبع المخزن
		if input == activeTouchInput then
			local pos = input.Position
			local delta = Vector2.new(pos.X, pos.Y) - touchStartPos
			local distance = delta.Magnitude

			if distance > maxRadius then
				delta = delta.Unit * maxRadius
			end

			innerKnob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
			moveVector = delta / maxRadius
		end
	end
end)

touchZone.InputEnded:Connect(function(input)
	-- إنهاء الحركة فقط إذا كان الاصبع المرفوع هو الاصبع المخصص للـ TouchZone
	if isTouching and input == activeTouchInput then
		resetTouch()
	end
end)

