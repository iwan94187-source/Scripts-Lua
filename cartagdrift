-- ⚙️ الوقت بالثواني قبل العودة (يمكنك تغييره هنا)
local delayTime = 0.3 -- الإجمالي الزمني للتنقل
local stepInterval = 0.05 -- زمن تحديث اللوب

tagplrBtn.MouseButton1Click:Connect(function()
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not hrp or not humanoid then return end
	printlog("Successful found character", false)

	----------------------------------------------------
	-- 1️⃣ تحديد الكائن المراد نقله (المركبة الحالية أو الشخصية)
	----------------------------------------------------
	currentVehicleModel = nil
	local rootPartToTeleport = hrp

	if humanoid.SeatPart then
		currentVehicleModel = humanoid.SeatPart:FindFirstAncestorOfClass("Model")
		if currentVehicleModel then
			printlog("Vehicle is " .. currentVehicleModel.Name, false)
			rootPartToTeleport = currentVehicleModel.PrimaryPart or humanoid.SeatPart

			if controleState then 
				local carScripts = currentVehicleModel:FindFirstChild("CarScripts")
				if carScripts then 
					local client = carScripts:FindFirstChild("Client")
					if client then
						-- 🛠️ استخدام FindFirstChild السلس لكل مستوى للتأكد من عدم حدوث الخطأ
						local input = client:FindFirstChild("Input")
						local touch = input and input:FindFirstChild("Touch")
						local touchGui = touch and touch:FindFirstChild("TouchGui")
						local controlframe = touchGui and touchGui:FindFirstChild("Controls")

						if controlframe then 
							printlog("Frame founded", false)
						else
							printlog("Frame not founded", true)
						end
					else
						printlog("Client not founded", true)
					end
				else
					printlog("CarScripts not founded", true)
				end
			end
		end
	end

	if not currentVehicleModel:FindFirstChild("Bomb") then 
		--printlog("Not Tagger yet.",true)
		return
	else
		--printlog("Susseccful tagger!.",false)
	end
	----------------------------------------------------
	-- 2️⃣ البحث عن أقرب موديل داخل vehiclesFolder
	----------------------------------------------------
	local nearestModel = nil
	local shortestDistance = math.huge
	local currentPos = rootPartToTeleport.Position

	for _, child in ipairs(vehiclesFolder:GetChildren()) do
		if child:IsA("Model") and child ~= currentVehicleModel then
			local targetPos = child.PrimaryPart and child.PrimaryPart.Position or child:GetPivot().Position
			local distance = (currentPos - targetPos).Magnitude
			if distance < shortestDistance then
				shortestDistance = distance
				nearestModel = child
			end
		end
	end

	----------------------------------------------------
	-- 3️⃣ عملية النقل الذكي المستمر (Smart Prediction Loop)
	----------------------------------------------------
	if nearestModel and not nearestModel:FindFirstChild("Bomb") then
		-- حفظ المكان الأصلي قبل البدء
		local originalCFrame = rootPartToTeleport.CFrame
		local targetPart = nearestModel.PrimaryPart or nearestModel:FindFirstChildWhichIsA("BasePart", true)

		if not targetPart then
			return
		end

		local elapsedTime = 0

		-- حلقة تتبع ونقل مستمرة كل 0.05 ثانية
		while elapsedTime < delayTime do
			-- جلب متجه السرعة ومقدارها (Studs per second)
			local velocity = targetPart.AssemblyLinearVelocity
			local speed = velocity.Magnitude

			-- حساب الإزاحة أمام اتجاه الحركة:
			-- إذا كانت السرعة عالية (> 30) نضع إزاحة 10 أمتار، وإذا كانت بطيئة نضع 5 أمتار
			local leadDistance = (speed > 30) and 10 or 5

			local targetCFrame = targetPart.CFrame
			if speed > 1 then
				-- إضافة الإزاحة باتجاه السرعة (Velocity Direction)
				local moveDirection = velocity.Unit
				targetCFrame = targetCFrame + (moveDirection * leadDistance)
			end

			-- تنفيذ الانتقال المستمر
			if currentVehicleModel then
				currentVehicleModel:PivotTo(targetCFrame)
			else
				hrp.CFrame = targetCFrame
			end

			task.wait(stepInterval)
			elapsedTime = elapsedTime + stepInterval
		end

		-- العودة إلى الموقع الأصلي بعد انتهاء الـ 0.3 ثانية
		if currentVehicleModel then
			currentVehicleModel:PivotTo(originalCFrame)
		else
			hrp.CFrame = originalCFrame
		end
	end
end)

