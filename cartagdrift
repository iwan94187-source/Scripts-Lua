runService.RenderStepped:Connect(function(deltaTime)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		local seatPart = humanoid.SeatPart

		if controleState and seatPart then
			if currentSeat ~= seatPart then
				setupSeatPhysics(seatPart)
			end
		else
			if currentSeat then
				clearSeatPhysics()
			end
		end

		-- تنفيذ التحكم فقط عند التفعيل وتوفر الكرسي
		if controleState and currentSeat and linearVelocity then
			local distance = moveVector.Magnitude

			if distance > 0.05 then
				-- حساب اتجاه الحركة بالنسبة للكاميرا (سلس ومباشر)
				local camCFrame = camera.CFrame
				local camForward = Vector3.new(camCFrame.LookVector.X, 0, camCFrame.LookVector.Z).Unit
				local camRight = Vector3.new(camCFrame.RightVector.X, 0, camCFrame.RightVector.Z).Unit

				-- الاتجاه المستهدف بناءً على سحبة الأصبع على الدائرة
				local targetDirection = (camRight * moveVector.X + camForward * (-moveVector.Y)).Unit

				-- 1. الدوران الفوري المباشر نحو الاتجاه المراد (Look At)
				local currentCFrame = currentSeat.CFrame
				local targetCFrame = CFrame.lookAt(currentCFrame.Position, currentCFrame.Position + targetDirection)

				-- تنعيم الانعطاف السريع جداً لتفادي التقطع Visual Glitch
				currentSeat.CFrame = currentCFrame:Lerp(targetCFrame, math.clamp(1 - (turnResponse ^ (deltaTime * 60)), 0, 1))

				-- 2. الحركة المباشرة نحو الاتجاه الجديد بنفس سرعة الأصبع
				local targetSpeed = distance * maxSpeed
				currentSpeed = currentSpeed + (targetSpeed - currentSpeed) * math.clamp(acceleration * deltaTime, 0, 1)

				linearVelocity.VectorVelocity = targetDirection * currentSpeed
			else
				-- التوقف عند ترك الشاشة
				currentSpeed = currentSpeed + (0 - currentSpeed) * math.clamp(acceleration * deltaTime, 0, 1)
				linearVelocity.VectorVelocity = Vector3.zero
			end
		end
	end
end)

