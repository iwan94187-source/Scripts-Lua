local players = game:GetService("Players")
local player = players.LocalPlayer
local playerGui = player.PlayerGui

local runService=game:GetService("RunService")

-- Create a Main-Menu
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BlackGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local screenGuiTem = Instance.new("ScreenGui")
screenGuiTem.Name = "temGui"
screenGuiTem.ResetOnSpawn = false
screenGuiTem.Parent = playerGui

local IsOpen = false -- حالة الزر

-- زر التحكم بتشغيل واغلاق الفريم
local closeBtn = Instance.new("TextButton")
closeBtn.Size=UDim2.new(0,50,0,50)
closeBtn.Position=UDim2.new(0,0,0,0)
closeBtn.BackgroundColor=BrickColor.new("Black")
closeBtn.TextColor3=Color3.new(0.886275, 0.027451, 1)
closeBtn.Text="⁇"
closeBtn.TextScaled=true
closeBtn.Parent=screenGui


local function UIcorner(ui) 
	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 10)
	uiCorner.Parent = ui

	-- 4. إطار خارجي رمادي خفيف للتمييز (اختياري)
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(40, 40, 40)
	uiStroke.Thickness = 1.5
	uiStroke.Parent = ui
	return uiCorner
end 

-- انشاء الفريم
local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.new(0, 400, 0, 300) -- الحجم: 300 عرض × 200 ارتفاع
frame.Position = UDim2.new(0.5, -250, 0.5, -200)
frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- لون أسود خالص
frame.BorderSizePixel = 0
frame.Visible = false
frame.Active=true
frame.Draggable = true -- يجعل النافذة قابلة للسحب
frame.Parent = screenGui

-- انشاء عنوانا للفريم
local lbl = Instance.new("TextLabel")
lbl.Size=UDim2.new(1,0,0.1,0)
lbl.BackgroundTransparency=1
lbl.TextXAlignment=Enum.TextXAlignment.Left
lbl.Text="Endless v2.0"
lbl.TextScaled=true
lbl.TextColor=BrickColor.new("White")
lbl.Parent=frame


-- انشاء الازرار داخل الفريم
local pBtn = Instance.new("TextButton")
pBtn.Size=UDim2.new(0,100,0,40)
pBtn.Position=UDim2.new(0,0,0.1,0)
pBtn.TextColor=BrickColor.new("White")
pBtn.BackgroundColor=BrickColor.new("Royal purple")
pBtn.TextSize=15
pBtn.Text="Player"
pBtn.Parent=frame

local uniBtn = Instance.new("TextButton")
uniBtn.Size=UDim2.new(0,100,0,40)
uniBtn.Position=UDim2.new(0,0,0.2,0)
uniBtn.TextColor=BrickColor.new("White")
uniBtn.BackgroundColor=BrickColor.new("Royal purple")
uniBtn.TextSize=15
uniBtn.Text="Universal"
uniBtn.Parent=frame

local function NewScroll()
	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Size=UDim2.new(0.75,0,0.9,0)
	scrollFrame.Position=UDim2.new(0.25,0,0.1,0)
	scrollFrame.BackgroundColor=BrickColor.new("Black")
	scrollFrame.Visible=false
	scrollFrame.Parent=frame

	return scrollFrame
end

local oldfog = nil

local pScrollFrame = NewScroll()

local function newBtn(name, pos) 
	local spd = Instance.new("TextButton")
	spd.Size=UDim2.new(0.3,0,0.05,0)
	spd.Position=pos
	spd.TextColor=BrickColor.new("White")
	spd.BackgroundColor=BrickColor.new("Really red")
	spd.TextSize=15
	spd.Text=name
	spd.Parent=pScrollFrame
	return spd
end

local function newScrollbtn(pos) 
	local scl = Instance.new("TextBox")
	scl.Size=UDim2.new(0.7,0,0.05,0)
	scl.Position=pos
	scl.TextColor=BrickColor.new("White")
	scl.BackgroundColor3=Color3.new(0.486275, 0, 0.729412)
	scl.TextSize=15
	scl.Text="Number"
	scl.Parent=pScrollFrame
	return scl
end

-- Speed-Button
