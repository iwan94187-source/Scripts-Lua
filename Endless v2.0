local uniScrollFrame = NewScroll()

local function newBtns(name, pos)
	local btn=Instance.new("TextButton")
	btn.Size=UDim2.new(1,0,0.05,0)
	btn.Position=pos
	btn.TextColor=BrickColor.new("White")
	btn.BackgroundColor=BrickColor.new("Royal purple")
	btn.TextSize=15
	btn.TextStrokeTransparency=0
	btn.Text=name
	btn.Parent=uniScrollFrame
	return btn
end
noclipBtn=newBtns("Noclip",UDim2.new())
espPlayerBtn=newBtns("Esp Players",UDim2.new(0,0,0.11,0))
fakeFloorBtn=newBtns("Fake floor",UDim2.new(0,0,0.155,0))

