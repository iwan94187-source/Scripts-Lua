-- حدث الضغط على الزر
closeBtn.MouseButton1Click:Connect(function()
	IsOpen=not IsOpen
	if IsOpen then 
		closeBtn.Text="X"
		closeBtn.TextColor=BrickColor.new("White")
	else 
		closeBtn.Text="⁇"
		closeBtn.TextColor=BrickColor.new("Royal purple")
	end
	frame.Visible=IsOpen
end)


local btnTag = nil


local function SetBtnState(scroll) 
	for _, with in ipairs(frame:GetChildren()) do 
		if with:IsA("ScrollingFrame") then 
			if with ~= scroll then with.Visible=false	
			end
		end
	end
	scroll.Visible=true
end

pBtn.MouseButton1Click:Connect(function()
	SetBtnState(pScrollFrame)
end)

uniBtn.MouseButton1Click:Connect(function()
	SetBtnState(uniScrollFrame)
end)

runService.Stepped:Connect(function()
	local human =player.Character and player.Character:FindFirstChild("Humanoid")
	if human then 
		if speedState then 
			if tonumber(speedTxtbox.Text) then
				human.WalkSpeed=speedTxtbox.Text
			end

		end

		if jumpState then 
			if tonumber(jumpTxtbox.Text) then
				human.UseJumpPower=true
				human.JumpPower=jumpTxtbox.Text
			end
		end

		if hipState then 
			if tonumber(hipTxtbox.Text) then
				human.HipHeight=hipTxtbox.Text
			end

		end
	end
end)

speedBtn.MouseButton1Click:Connect(function()
	speedState=not speedState
	if speedState then speedBtn.BackgroundColor=BrickColor.new("Bright green")
	else speedBtn.BackgroundColor=BrickColor.new("Really red") end
end)

jumpBtn.MouseButton1Click:Connect(function()
