	else hipBtn.BackgroundColor=BrickColor.new("Really red") end
end)

noclipBtn.MouseButton1Click:Connect(function()
	task.spawn(function()

		local IsOn = false

		-- الإطار الرئيسي (الخلفية)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 200, 0, 110)
		frame.Position = UDim2.new(0.3, 0, 0.15, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		frame.Active = true
		frame.Draggable = true -- يجعل النافذة قابلة للسحب!
		frame.Parent = screenGuiTem

		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 10)
		frameCorner.Parent = frame

		local frameStroke = Instance.new("UIStroke")
		frameStroke.Color = Color3.fromRGB(50, 50, 50)
		frameStroke.Thickness = 1.5
		frameStroke.Parent = frame

		-- العنوان
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 0, 40)
		txt.BackgroundTransparency = 1
		txt.Text = "NoClip"
		txt.TextScaled = true
		txt.TextColor3 = Color3.fromRGB(255, 255, 255)
		txt.Font = Enum.Font.GothamBold
		txt.Parent = frame

		-- الزر
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 35)
		btn.Position = UDim2.new(0.15, 0, 0.5, 0)
		btn.Text = "OFF"
		btn.TextScaled = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn

		-- 🎨 تفاعلات الماوس (Hover & Click Effects)
		local colorOff = Color3.fromRGB(220, 50, 50)
		local colorOn = Color3.fromRGB(50, 200, 90)

		runService.Stepped:Connect(function()
			local character = player.Character
			if not character then return end
			local humanoid = character:FindFirstChild("Humanoid")
			if IsOn and humanoid and not humanoid.Sit then
				for _, body in ipairs(character:GetChildren()) do 
					if body:IsA("BasePart") then 
						body.CanCollide=false
					end
				end
			end
		end)

		btn.MouseButton1Click:Connect(function()
			local character = player.Character
			if not character then return end
			IsOn = not IsOn
			if IsOn then 
				btn.Text = "ON"
				btn.BackgroundColor3 = colorOn
			else
				btn.Text = "OFF"
				btn.BackgroundColor3 = colorOff

				for _, body in ipairs(character:GetChildren()) do 
					if body:IsA("BasePart") then 
						body.CanCollide=true
					end
				end
			end
		end)
	end)
end)

spectateCam1.MouseButton1Click:Connect(function()
	task.spawn(function()
		local cam = workspace.CurrentCamera
		local runService = game:GetService("RunService")
		local IsOn = false

		-- إنشاء الشاشة الرئيسية

		-- الإطار الرئيسي (الخلفية)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 200, 0, 110)
		frame.Position = UDim2.new(0.3, 0, 0.15, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		frame.Active = true
		frame.Draggable = true -- يجعل النافذة قابلة للسحب!
		frame.Parent = screenGuiTem

		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 10)
		frameCorner.Parent = frame

		local frameStroke = Instance.new("UIStroke")
		frameStroke.Color = Color3.fromRGB(50, 50, 50)
		frameStroke.Thickness = 1.5
		frameStroke.Parent = frame

		-- العنوان
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 0, 40)
		txt.BackgroundTransparency = 1
		txt.Text = "Spectate"
		txt.TextScaled = true
		txt.TextColor3 = Color3.fromRGB(255, 255, 255)
		txt.Font = Enum.Font.GothamBold
		txt.Parent = frame

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 35)
		btn.Position = UDim2.new(0.15, 0, 0.5, 0)
		btn.Text = "OFF"
		btn.TextScaled = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn
		-- 🎨 تفاعلات الماوس (Hover & Click Effects)

		local colorOff = Color3.fromRGB(220, 50, 50)
		local colorOn = Color3.fromRGB(50, 200, 90)

		local spectateFrame = Instance.new("Frame")
		spectateFrame.Size=UDim2.new(1,0,0,300)
		spectateFrame.Position=UDim2.new(0,0,0.7,0)
		spectateFrame.BackgroundTransparency=1
		spectateFrame.Visible=false
		spectateFrame.Parent=screenGui

		local plrUser = Instance.new("TextLabel")
		plrUser.Size=UDim2.new(0.2,0,0.2,0)
		plrUser.Position=UDim2.new(0.4,0,0,0)
		plrUser.BackgroundTransparency=0.8
		plrUser.Text="Player"
		plrUser.TextColor=BrickColor.new("White")
		plrUser.TextScaled=true
		plrUser.Parent=spectateFrame

		local R_way = Instance.new("TextButton")
		R_way.Size=UDim2.new(0.05,0,0.2,0)
		R_way.Position=UDim2.new(0.7,0,0,0)
		R_way.BackgroundTransparency=0.8
		R_way.Text=">"
		R_way.TextColor=BrickColor.new("White")
		R_way.TextScaled=true
		R_way.Parent=spectateFrame

		local L_way = Instance.new("TextButton")
		L_way.Size=UDim2.new(0.05,0,0.2,0)
		L_way.Position=UDim2.new(0.25,0,0)
		L_way.BackgroundTransparency=0.8
		L_way.Text="<"
		L_way.TextColor=BrickColor.new("White")
		L_way.TextScaled=true
		L_way.Parent=spectateFrame

		local playersChange = nil
		local playersTag = {}
		local maxTag = nil
		local tag = 1

		btn.MouseButton1Click:Connect(function()
			playersTag={}
			IsOn = not IsOn
			if IsOn then 
				tag=1
				for _, player in ipairs(players:GetPlayers()) do	
					playersTag[#playersTag+1] = player
				end
				maxTag=#playersTag
				btn.Text = "ON"
				btn.BackgroundColor3 = colorOn
			else
				local human = player.Character and player.Character:FindFirstChild("Humanoid")
				if human then 
					cam.CameraSubject=human
				end
				btn.Text = "OFF"
				btn.BackgroundColor3 = colorOff
			end
			print(playersTag)
			spectateFrame.Visible=IsOn
		end)

		R_way.MouseButton1Click:Connect(function()
			if tag < maxTag then 
				tag+=1
			end
		end)

		L_way.MouseButton1Click:Connect(function()
			if tag > 1 then 
				tag-=1
			end
		end)

		runService.Heartbeat:Connect(function()
			if #playersTag > 0 then 
				local p =  playersTag[tag]

				plrUser.Text=p.Name

				local human = p.Character and p.Character:FindFirstChild("Humanoid")
				if human then 
					cam.CameraSubject=human
				end

			else 
				local human = player.Character and player.Character:FindFirstChild("Humanoid")
				if human then 
					cam.CameraSubject=human
				end
			end
		end)

		players.PlayerRemoving:Connect(function(playerRemoved)
			if IsOn and maxTag > 0 then 
				for index, rem in ipairs(playersTag) do 
					if rem == playerRemoved then 
						table.remove(playersTag, index)
						maxTag-=1

						if tag > maxTag then tag -= 1 end 
					end
				end
			end
		end)
	end)
end)

spectateCam2.MouseButton1Click:Connect(function()
	task.spawn(function()
		local cam = workspace.CurrentCamera

		local runService = game:GetService("RunService")

		local IsOn = false
		local default = "Username"
		-- إنشاء الشاشة الرئيسية

		-- الإطار الرئيسي (الخلفية)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 200, 0, 110)
		frame.Position = UDim2.new(0.3, 0, 0.15, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		frame.Active = true
		frame.Draggable = true -- يجعل النافذة قابلة للسحب!
		frame.Parent = screenGuiTem

		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 10)
		frameCorner.Parent = frame

		local frameStroke = Instance.new("UIStroke")
		frameStroke.Color = Color3.fromRGB(50, 50, 50)
		frameStroke.Thickness = 1.5
		frameStroke.Parent = frame

		-- العنوان
		local txt = Instance.new("TextBox")
		txt.Size = UDim2.new(1, 0, 0, 40)
		txt.BackgroundTransparency = 1
		txt.Text = default
		txt.TextScaled = true
		txt.TextColor3 = Color3.fromRGB(255, 255, 255)
		txt.Font = Enum.Font.GothamBold
		txt.Parent = frame

		-- الزر
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 35)
		btn.Position = UDim2.new(0.15, 0, 0.5, 0)
		btn.Text = "OFF"
		btn.TextScaled = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn

		-- 🎨 تفاعلات الماوس (Hover & Click Effects)
		local colorOff = Color3.fromRGB(220, 50, 50)
		local colorOn = Color3.fromRGB(50, 200, 90)

		local function GetPlayer()
			local user=nil

			for _, player in ipairs(players:GetPlayers()) do 
				local pName = player.Name:lower()
				local Intxt = txt.Text:lower()
				if string.sub(pName, 1, #Intxt) == Intxt and Intxt ~= "" then 
					user=player
					print(player.Name.." was spectated!")
				end
			end
			return user
		end


		btn.MouseButton1Click:Connect(function()

			IsOn = not IsOn
			if IsOn then 
				btn.Text = "ON"
				btn.BackgroundColor3 = colorOn

				local user = GetPlayer()
				if user then 
					local targetHuman = user.Character and user.Character:FindFirstChild("Humanoid")

					if not targetHuman then return end
					cam.CameraSubject=targetHuman
				end
			else
				btn.Text = "OFF"
				btn.BackgroundColor3 = colorOff

				local human = player.Character and player.Character:FindFirstChild("Humanoid")
				if not human then return end
				cam.CameraSubject=human
			end
		end)

		txt:GetPropertyChangedSignal("Text"):Connect(function()
			if not IsOn then return end 
			local user = GetPlayer()
			if user then 
				local targetHuman = user.Character and user.Character:FindFirstChild("Humanoid")

				if not targetHuman then return end
				cam.CameraSubject=targetHuman
			end
		end)
	end)
end)

espPlayerBtn.MouseButton1Click:Connect(function()
	task.spawn(function()
		local IsOn = false

		-- إنشاء الشاشة الرئيسية

		-- الإطار الرئيسي (الخلفية)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 200, 0, 110)
		frame.Position = UDim2.new(0.3, 0, 0.15, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		frame.Active = true
		frame.Draggable = true -- يجعل النافذة قابلة للسحب!
		frame.Parent = screenGuiTem

		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 10)
		frameCorner.Parent = frame

		local frameStroke = Instance.new("UIStroke")
		frameStroke.Color = Color3.fromRGB(50, 50, 50)
		frameStroke.Thickness = 1.5
		frameStroke.Parent = frame

		-- العنوان
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 0, 40)
		txt.BackgroundTransparency = 1
		txt.Text = "ESP"
		txt.TextScaled = true
		txt.TextColor3 = Color3.fromRGB(255, 255, 255)
		txt.Font = Enum.Font.GothamBold
		txt.Parent = frame

		-- الزر
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 35)
		btn.Position = UDim2.new(0.15, 0, 0.5, 0)
		btn.Text = "OFF"
		btn.TextScaled = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn

		-- 🎨 تفاعلات الماوس (Hover & Click Effects)
		local colorOff = Color3.fromRGB(220, 50, 50)
		local colorOn = Color3.fromRGB(50, 200, 90)

		local playersEsp = {}

		local function newPlayer(plr)
			plr.CharacterAdded:Connect(function(character)
				if IsOn then 
					local highlight = Instance.new("Highlight")
					highlight.Parent=character
					playersEsp[#playersEsp+1] = highlight
				end
			end)
		end

		for _, player in ipairs(players:GetPlayers()) do 
			newPlayer(player)
		end


		btn.MouseButton1Click:Connect(function()
			IsOn = not IsOn
			if IsOn then 

				for _, player in ipairs(players:GetPlayers()) do 
					if player and player ~= players.LocalPlayer then 
						local character=player.Character

						if not character then continue end

						local highlight = Instance.new("Highlight")
						highlight.Parent=character
						playersEsp[#playersEsp+1] = highlight

					end	
				end
				btn.Text = "ON"
				btn.BackgroundColor3 = colorOn

			else
				btn.Text = "OFF"
				btn.BackgroundColor3 = colorOff
				if playersEsp then 
					for index = 1 ,#playersEsp do 
						playersEsp[index]:Destroy()
					end
					playersEsp={}
				end
			end
		end)

		players.PlayerAdded:Connect(function(player)
			newPlayer(player)
		end)
	end)
end)

fakeFloorBtn.MouseButton1Click:Connect(function()
	task.spawn(function()

		local IsApply=false

		local Oldfloor = nil
		local oldPos = nil

		-- الإطار الرئيسي (الخلفية)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(0, 200, 0, 110)
		frame.Position = UDim2.new(0.3, 0, 0.15, 0)
		frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		frame.Active = true
		frame.Draggable = true -- يجعل النافذة قابلة للسحب!
		frame.Parent = screenGuiTem

		local frameCorner = Instance.new("UICorner")
		frameCorner.CornerRadius = UDim.new(0, 10)
		frameCorner.Parent = frame

		local frameStroke = Instance.new("UIStroke")
		frameStroke.Color = Color3.fromRGB(50, 50, 50)
		frameStroke.Thickness = 1.5
		frameStroke.Parent = frame
		-- العنوان
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 0, 40)
		txt.BackgroundTransparency = 1
		txt.Text = "Fake Floor"
		txt.TextScaled = true
		txt.TextColor3 = Color3.fromRGB(255, 255, 255)
		txt.Font = Enum.Font.GothamBold
		txt.Parent = frame

		-- الزر
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 140, 0, 35)
		btn.Position = UDim2.new(0.15, 0, 0.5, 0)
		btn.Text = "OFF"
		btn.TextScaled = true
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		btn.Parent = frame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn

		-- 🎨 تفاعلات الماوس (Hover & Click Effects)
		local colorOff = Color3.fromRGB(220, 50, 50)
		local colorOn = Color3.fromRGB(50, 200, 90)

		btn.MouseButton1Click:Connect(function()

			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local human = player.Character and player.Character:FindFirstChild("Humanoid")
			if not root or not human then return end

			IsApply=not IsApply
			if IsApply then 
				local floor=Instance.new("Part")
				floor.Size = Vector3.new(512,floor.Size.Y,512)
				floor.Position = root.Position - Vector3.new(0,4.75,0)
				floor.Transparency=1
				floor.Anchored=true

				floor.Parent=workspace

				Oldfloor = floor
				oldPos=Oldfloor.Position.Y
				btn.Text = "ON"
			else
				Oldfloor:Destroy()
				btn.Text = "OFF"
			end
		end)

		runsService.Stepped:Connect(function()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local human = player.Character and player.Character:FindFirstChild("Humanoid")
			if not root or not human then return end

			if IsApply then 
				Oldfloor.Position = Vector3.new(root.Position.X,oldPos,root.Position.Z)
			end
		end)
	end)
end)
