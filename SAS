								isClosestEnemy = true, origin = myHRP.Position,
								enemyModel = p.Character, distance = dist, knockback = 50
							}}

							-- استدعاء أمن دون تكديس الـ Threads
							pcall(function()
								Remote:InvokeServer("AttemptWeaponHit", attackData, hitData)
							end)
						end
					end
				end
			end
		end
		task.wait(0.1) 
