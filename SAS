-- 2. دالة التأكد من تواجد اللاعب داخل نطاق الموديل بالكامل (Bounding Box)
local function isPlayerInsideModelBox(playerRoot, targetModel, margin)
	margin = margin or 3 -- هامش مرونة إضافي بحسب الارتفاع وقرب اللاعب من الحواف

	-- الحصول على مركز الموديل وحجمه الكلي الإجمالي
	local modelCFrame, modelSize = targetModel:GetBoundingBox()

	-- تحويل موقع اللاعب بالنسبة لمركز الموديل
	local localPos = modelCFrame:PointToObjectSpace(playerRoot.Position)
	local halfSize = modelSize / 2

	-- فحص المحاور الثلاثة X, Y, Z لنطاق الموديل الكلي
	return math.abs(localPos.X) <= (halfSize.X + margin)
		and math.abs(localPos.Y) <= (halfSize.Y + margin)
		and math.abs(localPos.Z) <= (halfSize.Z + margin)
end

-- 3. دالة البحث والنقل للأقرب داخل الموديل
local function checkAndTeleport(distanceBehind)
	distanceBehind = distanceBehind or 3

	local myChar = localplayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
	if not myHumanoid or myHumanoid.Health <= 0 then return end
	local myRoot = myChar.HumanoidRootPart

	local targetModel = getTargetModel()
	if not targetModel then return end

	local closestPlayer = nil
	local shortestDistance = math.huge

	-- البحث بين اللاعبين الأحياء
	for _, player in ipairs(players:GetPlayers()) do
		if player ~= localplayer and player.Character then
			local char = player.Character
			local targetRoot = char:FindFirstChild("HumanoidRootPart")
			local targetHumanoid = char:FindFirstChildOfClass("Humanoid")

			-- الشرط: حي + ينتمي لداخل النطاق الإجمالي للموديل
			if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
				if isPlayerInsideModelBox(targetRoot, targetModel, 3) then
					local dist = (myRoot.Position - targetRoot.Position).Magnitude

					if dist < shortestDistance then
						shortestDistance = dist
						closestPlayer = player
					end
				end
			end
		end
	end

	-- تنفيذ الانتقال خلف اللاعب المتواجد داخل الموديل
	if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local targetRoot = closestPlayer.Character.HumanoidRootPart
		myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, distanceBehind)
	end
end

