			local currentTool = char and char:FindFirstChildOfClass("Tool")

			-- التنفيذ فقط عند وجود شخصية وأداة مجهزة
			if myHRP and currentTool then
				for _, p in pairs(players:GetPlayers()) do
					if p ~= localplayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						local targetHRP = p.Character.HumanoidRootPart
						local dist = (targetHRP.Position - myHRP.Position).Magnitude

						if dist <= Reach then
							local attackData = {
								attackCycleData = {lungeMult = 2, slowMult = 0, slowTime = 0, knockbackMult = 1, attackTime = 0.1},
								knockback = 50, shouldLock = false, slowTime = 0, shouldLunge = true, isCritical = true,
