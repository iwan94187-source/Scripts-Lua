										["2"] = {knockbackMul = 1, slowMult = 0, slowTime = 0, lungeMul = 1, attackTime = 0.1}
									},
									attackOrder = {"1", "2"}
								},
								attackCooldown = 0, shouldSlow = false, lungeKnockback = 50,
								hitboxSize = Vector3.new(HitboxSize, HitboxSize, HitboxSize),
								slowMult = 0, cycleIndex = 1,
								tool = currentTool,
								damage = damage
							}
							local hitData = {{
