-- دالة لحساب المعادلات النصية وفق أسبقيات الرياضيات
local function evalMath(expression)
	-- 1. تنظيف النص وتحويل الرموز الشائعة
	expression = string.gsub(expression, "%s+", "") -- إزالة الفراغات
	expression = string.gsub(expression, "÷", "/") -- تحويل ÷ إلى /
	expression = string.gsub(expression, "×", "*")
	
	-- 2. معالجة عمليات الضرب والقسمة أولاً (الأسبقية الأولى)
	while string.find(expression, "[%d%.]+[%*%/][%d%.]+") do
		expression = string.gsub(expression, "([%d%.]+)([%*%/])([%d%.]+)", function(a, op, b)
			local num1, num2 = tonumber(a), tonumber(b)
			if op == "*" then
				return tostring(num1 * num2)
			elseif op == "/" then
				return num2 ~= 0 and tostring(num1 / num2) or "0"
			end
		end)
	end

	-- 3. معالجة عمليات الجمع والطرح ثانياً (الأسبقية الثانية)
	while string.find(expression, "[%d%.]+[%+%-][%d%.]+") do
		expression = string.gsub(expression, "([%d%.]+)([%+%-])([%d%.]+)", function(a, op, b)
			local num1, num2 = tonumber(a), tonumber(b)
			if op == "+" then
				return tostring(num1 + num2)
			elseif op == "-" then
				return tostring(num1 - num2)
			end
		end)
	end

	return tonumber(expression)
end

-- دمج الدالة داخل حلقة Heartbeat
runService.Heartbeat:Connect(function()
	if solutionLbl and lines and lines[1] then
		local questionText = lines[1].Text or tostring(lines[1])

		-- 1. قطع النص عند علامة '=' ليأخذ المعادلة التي قبلها فقط
		local beforeEquals = string.match(questionText, "^([^=]+)") or questionText

		-- 2. استخراج الأرقام والعمليات الحسابية من النص المقطوع
		local cleanExpr = string.match(beforeEquals, "[%d%s%+%-%*%/%x%X%÷%.]+")

		if cleanExpr and string.gsub(cleanExpr, "%s+", "") ~= "" then
			local result = evalMath(cleanExpr)
			if result then
				if autoGuessState and send then
					send=false
					dubEvent:FireServer(tostring(result)) 
				end
				solutionLbl.TextColor = BrickColor.new("Lime green")
				solutionLbl.Text = "Solution: " .. tostring(result)
			else
				send=false
				solutionLbl.TextColor = BrickColor.new("Really red")
				solutionLbl.Text = "Solution: ??"
			end
		else
			send=false
			solutionLbl.TextColor = BrickColor.new("Really red")
			solutionLbl.Text = "Solution: ??"
		end
	end
end)

runService.Heartbeat:Connect(function()
	if MoveEnabledState then
		local char = LocalPlayer.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")

		if rootPart and humanoid and humanoid.Health > 0 then
			-- 1. إذا كان اللاعب جالساً، يتم إجباره على الوقوف وفك الالتصاق بالمقعد
			if humanoid.Sit then
				humanoid.Sit = false
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end

			humanoid.UseJumpPower, humanoid.JumpPower = true, 99
			humanoid.WalkSpeed = 22

			-- 2. إعادة تفعيل التدوير التلقائي
			humanoid.AutoRotate = true

			-- 3. إجبار تدوير الوجه باتجاه الحركة (MoveDirection) عند المشي
			local moveDir = humanoid.MoveDirection
			if moveDir.Magnitude > 0 then
				local currentPos = rootPart.Position
				-- الحفاظ على مستوى الارتفاع Z/X وتوجيه النظر للأمام فقط
				local targetLook = currentPos + Vector3.new(moveDir.X, 0, moveDir.Z)
				rootPart.CFrame = CFrame.new(currentPos, targetLook)
			end
		end
	end
end)

