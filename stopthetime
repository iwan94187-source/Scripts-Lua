local targetTimer = nil
local targetslot = nil
local timerStop = nil
local BeBtn = nil
local extractedNumber = nil

local isWaitingForReset = false
local lastClickedTimerValue = nil
local lastTimerValue = nil
local lastFrameTime = nil
printlog("02939",false)
task.spawn(function()
	while true do
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local currentMyArea = nil

		if myRoot and gameFolder then
			for _, child in ipairs(gameFolder:GetChildren()) do
				if child:IsA("Model") then
					local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
					if primaryPart then
						local cframe, size = child:GetBoundingBox()
						local localPos = cframe:PointToObjectSpace(myRoot.Position)
						if math.abs(localPos.X) <= (size.X / 2) and
							math.abs(localPos.Y) <= (size.Y / 2) and
							math.abs(localPos.Z) <= (size.Z / 2) then
							currentMyArea = child
							break
						end
					end
				end
			end
		end

		if currentMyArea and myRoot then
			local chairs = currentMyArea:FindFirstChild("Chairs")
			local mytable = currentMyArea:FindFirstChild("Table")
			local timerModel = currentMyArea:FindFirstChild("Timer")
			local buttons = currentMyArea:FindFirstChild("Buttons")

			-- العثور على الطاولة واستخراج الرقم المطلوب
			if mytable then 
				for _, dex in ipairs(mytable:GetDescendants()) do
					if dex:IsA("TextLabel") and dex.Name == "TimeToSet" then 
						targetTimer = dex
						break				
					end
				end

				if targetTimer then 
					local cleanText = string.gsub(targetTimer.Text, "<[^>]+>", "")
					local numberString = string.match(cleanText, "%d+%.?%d*")
					if numberString then
						extractedNumber = tonumber(numberString)
					end
				end
			end

			-- العثور على الكرسي والزر والمؤقت الخاص بك
			if chairs then  
				for _, dex in ipairs(chairs:GetDescendants()) do
					if dex:IsA("Weld") and dex.Name == "SeatWeld" and dex.Part1 == myRoot then 
						targetslot = dex.Parent and dex.Parent.Parent
						break
					end
				end 

				if targetslot then 
					if timerModel then 
						local base = timerModel:FindFirstChild(targetslot.Name)
						if base then 
							for _, dex in ipairs(base:GetDescendants()) do 
								if dex:IsA("TextLabel") and dex.Name == "TimerText" then 
									timerStop = dex
									break
								end
							end
						end
					end

					if buttons then 
						local model = buttons:FindFirstChild(targetslot.Name)
						if model and model:FindFirstChild("Button") then 
							BeBtn = model.Button
						end
					end
				end
			end
		else
			-- تصفير جميع المتغيرات عند الخروج من المنطقة
			targetTimer = nil
			targetslot = nil
			timerStop = nil
			BeBtn = nil
			extractedNumber = nil
		end

		-- الانتظار ربع ثانية قبل الفحص القادم لخفيض الضغط عن اللعبة
		task.wait(0.25)
	end
end)

local velocitySamples = {} -- مصفوفة لتخزين سرعات الفريمات الأخيرة وتنظيف التذبذب

RunService.Heartbeat:Connect(function()
	if not autoStopState or not timerStop or not extractedNumber or not BeBtn then
		return
	end

	-- قراءة سريعة ومباشرة تحسباً للتأخير النصي
	local rawText = timerStop.Text
	local numberString = string.match(rawText, "%d+%.?%d*")
	local currentTimerValue = numberString and tonumber(numberString)
	local currentTime = os.clock()

	if not currentTimerValue then return end

	-- 1. إعادة الضبط للدورة الجديدة
	if isWaitingForReset then
		if math.abs(currentTimerValue - (lastClickedTimerValue or 0)) > 0.05 then
			isWaitingForReset = false
			lastClickedTimerValue = nil
			lastTimerValue = nil
			lastFrameTime = nil
			velocitySamples = {}
		end
		return
	end

	-- 2. حساب السرعة وتنعيمها (Smooth Rate Prediction)
	local predictedNextValue = currentTimerValue

	if lastTimerValue and lastFrameTime then
		local deltaTime = currentTime - lastFrameTime
		local valueChange = currentTimerValue - lastTimerValue

		if deltaTime > 0 and valueChange > 0 then
			local instantRate = valueChange / deltaTime

			-- إدراج السرعة الحالية لحساب المتوسط لأخر 3 فريمات
			table.insert(velocitySamples, instantRate)
			if #velocitySamples > 3 then
				table.remove(velocitySamples, 1)
			end

			local averageRate = 0
			for _, rate in ipairs(velocitySamples) do
				averageRate = averageRate + rate
			end
			averageRate = averageRate / #velocitySamples

			-- التنبؤ المباشر للفريم القادم بدقة عالية
			predictedNextValue = currentTimerValue + (averageRate * deltaTime)
		end
	end

	lastTimerValue = currentTimerValue
	lastFrameTime = currentTime

	-- 3. شرط الضغط الدقيق
	if currentTimerValue >= extractedNumber or predictedNextValue >= extractedNumber then
		local camera = workspace.CurrentCamera
		local screenPosition, isOnScreen = camera:WorldToScreenPoint(BeBtn.Position)

		if isOnScreen then
			local topbarOffset = GuiService:GetGuiInset()
			local x = screenPosition.X + topbarOffset.X
			local y = screenPosition.Y + topbarOffset.Y

			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)

			isWaitingForReset = true
			lastClickedTimerValue = currentTimerValue
		end
	end
end)


