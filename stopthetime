RunService.Heartbeat:Connect(function()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then 
		return 
	end

	local myRoot = myChar.HumanoidRootPart
	local currentMyArea = nil

	for _, child in ipairs(gameFolder:GetChildren()) do
		if child:IsA("Model") then
			local isInside = false
			local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
			if primaryPart then
				local cframe, size = child:GetBoundingBox()
				local localPos = cframe:PointToObjectSpace(myRoot.Position)
				if math.abs(localPos.X) <= (size.X / 2) and
					math.abs(localPos.Y) <= (size.Y / 2) and
					math.abs(localPos.Z) <= (size.Z / 2) then
					isInside = true
				end
			end

			if isInside then
				currentMyArea = child
				break
			end
		end
	end

	if currentMyArea then
		local mytable = currentMyArea:FindFirstChild("Table")
		if mytable then 
			local targetTimer = nil 
			for _, dex in ipairs(mytable:GetDescendants()) do
				if dex:IsA("TextLabel") and dex.Name == "TimeToSet" then 
					targetTimer=dex
					break				
				end
			end
				
			if targetTimer then 
				printlog("TextLabel founded",false)
				local numberString = string.match(targetTimer.Text, ">(%d+)%s*</font>")

				if numberString then
						-- تحويل النص إلى رقم
					local extractedNumber = tonumber(numberString)

					printlog("الرقم المستخرج هو:".. extractedNumber,false)
						-- يمكنك الآن استخدام المتغير extractedNumber هنا أو إرساله للـ Server
				else
					printlog("لم يعمل الفلترة",true)
				end
			else
				printlog("TextLabel not found",true)
			end
			
		end
	end
end)

