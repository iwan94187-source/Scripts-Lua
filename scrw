-- 3. دالة جلب الهدف
local function getTargetPart()
	local folder = workspace:FindFirstChild("Generated")
	if folder then
		local exit = folder:FindFirstChild("Exit")
		if exit then
			local exitBlockerGroup = exit:FindFirstChild("ExitBlocker")
			if exitBlockerGroup then
				if exitBlockerGroup:IsA("BasePart") then
					return exitBlockerGroup
				else
					return exitBlockerGroup:FindFirstChild("ExitBlocker") or exitBlockerGroup:FindFirstChildWhichIsA("BasePart")
				end
			end
		end
	end
	return nil
end

