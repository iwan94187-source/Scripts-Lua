runService.Heartbeat:Connect(function()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local human = char and char:FindFirstChildOfClass("Humanoid")

	if speedState then 
		local human = player.Character and player.Character:FindFirstChild("Humanoid")
		if human and tonumber(speedBox.Text) then 
			human.WalkSpeed=speedBox.Text
		end
	end

	if lightState then 
		lightService.Ambient=Color3.fromRGB(170, 255, 255)
		lightService.Brightness=3
		local atm = lightService:FindFirstChild("Atmosphere")
		if atm then atm.Density = 0 end
	end

	if espBlockerState then 
		local folder = workspace:FindFirstChild("Generated")
		if folder then 
			local exitBlocker = folder:FindFirstChild("Exit")and folder:FindFirstChild("Exit"):FindFirstChild("ExitBlocker") 
			if exitBlocker then blockerOutline.Parent=exitBlocker end
		end
	end

	if espMonstersState then 
		local folder = workspace:FindFirstChild("Monsters")
		if folder then 
			for _, clown in ipairs(folder:GetChildren()) do 
				if clown:IsA("Model") then 
					local hold = false

					for _, item in ipairs(clown:GetChildren()) do 
						if item:IsA("Highlight") then hold=true end
					end
					if not hold then 
						local highlight = clawnOutline()
						highlight.Parent=clown
					end
				end
			end
		end
	end
	if espBalloonState then
		local folder = workspace:FindFirstChild("Generated")
		if folder then 
			for _, balloon in ipairs(folder:GetChildren()) do 
				if balloon:IsA("Model") and balloon.Name == "ClownBalloon" then 
					local hold = false
					for _, item in ipairs(balloon:GetChildren()) do 
						if item:IsA("Highlight") then hold=true end
					end
					if not hold then 
						local highlight = balloonOutline()
						highlight.Parent=balloon
					end
				end
			end
		end
	end

	if fullZoomState then 

		if player.CameraMode ~= Enum.CameraMode.Classic then
			player.CameraMode = Enum.CameraMode.Classic
		end
		if player.CameraMinZoomDistance < 2 then
			player.CameraMinZoomDistance = 2
			player.CameraMaxZoomDistance = 100
		end
	end
	
	if escapeLineState then
		local character = player.Character
		if not character then 
			clearLines()
			return 
		end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local targetPart = getTargetPart()

		if rootPart and targetPart and targetPart:IsA("BasePart") then
			local realTargetPos = targetPart.Position
			local elevatedTargetPos = realTargetPos + Vector3.new(0, ELEVATION_OFFSET, 0)
			local now = tick()

			-- نقطة البداية الحقيقية للرسم (عند أقدام اللاعب)
			local visualStartPos = rootPart.Position - Vector3.new(0, 1.5, 0)

			if now - lastCheck > 0.15 then
				lastCheck = now

				-- رفع نقطة بداية الحساب للخوارزمية بمقدار 2.5 unit (يحاكي القفز)
				local calculationStartPos = rootPart.Position + Vector3.new(0, 2.5, 0)
				local floorTargetPos = Vector3.new(realTargetPos.X, rootPart.Position.Y, realTargetPos.Z)

				local success = pcall(function()
					path:ComputeAsync(calculationStartPos, floorTargetPos)
				end)

				if success and path.Status == Enum.PathStatus.Success then
					waypoints = path:GetWaypoints()
					isPathValid = #waypoints > 1
				else
					waypoints = {}
					isPathValid = false
				end
			end

			clearLines()

			local totalDistance = (visualStartPos - realTargetPos).Magnitude
			local alpha = math.clamp(totalDistance / MAX_DISTANCE, 0, 1)
			local currentThickness = MAX_THICKNESS - (alpha * (MAX_THICKNESS - MIN_THICKNESS))

			if isPathValid and #waypoints > 1 then
				for i = 1, #waypoints - 1 do
					-- إسقاط الـ Waypoints لحساب مستوى الأرض للرسم البصري
					local w1 = Vector3.new(waypoints[i].Position.X, visualStartPos.Y + 0.4, waypoints[i].Position.Z)
					local w2 = Vector3.new(waypoints[i + 1].Position.X, visualStartPos.Y + 0.4, waypoints[i + 1].Position.Z)

					-- النقطة الأولى تبدأ مباشرة من قدم اللاعب
					if i == 1 then
						w1 = visualStartPos + Vector3.new(0, 0.4, 0)
					end

					-- النقطة الأخيرة ترتفع نحو الهدف
					if i == #waypoints - 1 then
						w2 = elevatedTargetPos
					end

					createSegment(w1, w2, currentThickness)
				end
			else
				-- خط احتياطي
				createSegment(visualStartPos, elevatedTargetPos, currentThickness)
			end
		else
			clearLines()
		end
	else
		-- في حال كانت escapeLineState تساوي false يتم مسح الخطوط القائمة لتوفير الأداء
		clearLines()
	end
	
	if noclipState then 
		local char = player.Character
		if char then 
			for _, item in ipairs(char:GetChildren()) do 
				if item:IsA("BasePart") then item.CanCollide=false end
			end
		end
	end
	
	if flyState and root and human then 
		flyLabel.Text=flyspeed
		local FLY_SPEED = flyspeed / 10
		
		human.PlatformStand = true

		-- تصفير السرعة الفيزيائية
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if not currentPosition then
			currentPosition = root.Position
		end

		-- 1. تعديل الارتفاع العمودي المباشر عبر الأزرار (Up / Down)
		if isUpHolding then
			currentPosition = currentPosition + Vector3.new(0, FLY_SPEED, 0)
		end
		if isDownHolding then
			currentPosition = currentPosition - Vector3.new(0, FLY_SPEED, 0)
		end

		-- 2. توجيه حركة المقبض / الكيبورد ثلاثية الأبعاد حسب اتجاه الكاميرا
		local rawMove = human.MoveDirection
		if rawMove.Magnitude > 0 then
			-- نحول المتجاهات الأفقية لـ MoveDirection إلى إحداثيات محلية (Local Relative)
			local relativeMove = camera.CFrame:VectorToObjectSpace(rawMove)

			-- ثم نضرب الحركة المحلية في CFrame الكاميرا بالكامل لنحصل على اتجاه النظرة الحقيقي (بما فيه فوق وتحت)
			local flyVector = camera.CFrame:VectorToWorldSpace(Vector3.new(relativeMove.X, 0, relativeMove.Z))

			currentPosition = currentPosition + (flyVector.Unit * FLY_SPEED)
		end

		-- 3. تثبيت دوران الشخصية مع اتجاه نظرة الكاميرا
		local lookDirection = camera.CFrame.LookVector
		root.CFrame = CFrame.new(currentPosition, currentPosition + lookDirection)
	else 
		currentPosition = nil
		isUpHolding = false
		isDownHolding = false
		if human then 
			human.PlatformStand = false 
		end
	end
end)

