-- 5. رسم قطعة خط بين نقطتين
local function createSegment(startPos, endPos, thickness)
	local distance = (startPos - endPos).Magnitude
	if distance < 0.1 then return end

	local line = Instance.new("Part")
	line.Name = "PathSegment"
	line.Anchored = true
	line.CanCollide = false
	line.CastShadow = false
	line.Material = Enum.Material.Neon
	line.Color = Color3.fromRGB(0, 255, 0)
	line.Size = Vector3.new(thickness, thickness, distance)
	line.CFrame = CFrame.new((startPos + endPos) / 2, endPos)
	line.Parent = lineFolder
end

