local function getGameName()
	local success, result = pcall(function()
		-- جلب معلومات الماب الحالي
		return MarketplaceService:GetProductInfo(game.PlaceId)
	end)

	if success and result and result.Name then
		return result.Name
	else
		return "Unknown Game" -- في حال فشل الاتصال أو تجربة السكربت بدون إنترنت
	end
end

local function getServerUptime()
	local totalSeconds = math.floor(workspace.DistributedGameTime)

	local hours = math.floor(totalSeconds / 3600)
	local minutes = math.floor((totalSeconds % 3600) / 60)
	local seconds = totalSeconds % 60

	-- تنسيق النتيجة لتبدو كـ 02h 15m 08s
	return string.format("%02dh %02dm %02ds", hours, minutes, seconds)
end

