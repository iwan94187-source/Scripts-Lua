local mainBtn, mainLbl, mainIcon = newBtn("Info", "rbxassetid://6771547001")
local gameBtn, gameLbl, gameIcon = newBtn("Game", "rbxassetid://76578801302055")
local playerBtn, playerLbl, playerIcon = newBtn("Player", "rbxassetid://84822678364928")

mainBtn.BackgroundTransparency = 0.75

local selectedBtn = mainBtn
local selectedFrame = frame_1

local function display(btn, frame)
	if selectedBtn == btn then return end
	selectedBtn.BackgroundTransparency = 1
	selectedFrame.Visible = false

	btn.BackgroundTransparency = 0
	frame.Visible = true

	selectedBtn = btn
	selectedFrame = frame
end

mainBtn.MouseButton1Click:Connect(function() display(mainBtn, frame_1) end)
gameBtn.MouseButton1Click:Connect(function() display(gameBtn, frame_2) end)
playerBtn.MouseButton1Click:Connect(function() display(playerBtn, frame_3) end)

