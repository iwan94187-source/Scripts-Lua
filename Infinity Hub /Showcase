-- 1. الدوال المساعدة
local function newUi(parent, radius) 
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius or 10)
	ui.Parent = parent
	return ui
end

local function newStroke(clr, siz, parent) 
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = clr
	uiStroke.Thickness = siz
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Parent = parent
end

local function newCustomUi(parent, rb, lb, ru, lu) 
	local ui = Instance.new("UICorner")
	ui.BottomLeftRadius = UDim.new(0, lb)
	ui.BottomRightRadius = UDim.new(0, rb)
	ui.TopLeftRadius = UDim.new(0, lu)
	ui.TopRightRadius = UDim.new(0, ru)
	ui.Parent = parent
	return ui
end

local function fixedTxt(parent, siz, pos)
	parent.TextTransparency = 1

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(siz, 0, 0.8, 0)
	lbl.Position = UDim2.new(pos, 0, 0.1, 0)
	lbl.TextColor = BrickColor.new("White")
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(24, 24, 24)
	lbl.FontFace=Font.fromEnum(Enum.Font.Roboto)
	lbl.BackgroundTransparency = 1
	lbl.Text = parent.Text
	lbl.TextScaled = true
	lbl.Parent = parent
	return lbl
end

