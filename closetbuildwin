								if descendant.Color == builtPart.Color then
									return true -- البلوك صحيح في الموقع واللون
								else
									return false -- البلوك في الموقع الصحيح ولكن لونه خاطئ
								end
							end
						end
					end

					return false -- لا يوجد أي بارت في المخطط بهذا الموقع (بلوك زائد)
				end
				
				local function executeAutoDestroy()
