						end

						local rightArm = myChar:FindFirstChild("Right Arm") or myChar:FindFirstChild("RightHand")
						local rightGrip = rightArm and rightArm:FindFirstChild("RightGrip")

						if rightGrip then
							
							bolt=true
							local closest = getClosestPlayer()

							if closest and closest.Character then
								local targetChar = closest.Character
								local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

								if targetHum and targetHum.Health > 0 and targetChar:IsDescendantOf(workspace) then
									local targetTorso = targetChar:FindFirstChild("Torso")

									if targetTorso then
										-- 1. إنشاء موقع جديد لشخصيتك بنفس إحداثياتك (X, Z) ولكن بارتفاع الهدف (Y)
										local myMatchedPos = Vector3.new(myRoot.Position.X, targetTorso.Position.Y, myRoot.Position.Z)

										-- 2. توجيه النظر بشكل طبيعي من موقعك المرتفع نحو موقع الهدف
										myRoot.CFrame = CFrame.lookAt(myMatchedPos, targetTorso.Position)
									end
								end
							end
						else
							bolt=false
							if originalY then
								myRoot.CFrame = CFrame.new(myRoot.Position.X, originalY, myRoot.Position.Z) * (myRoot.CFrame - myRoot.Position)
								originalY = nil
