				local function cacheSourceModel(sourceModel)
					if not sourceModel then return end

					-- 1. تصفير الـ Cache القديم والـ fakeDemoModel الحالي فوراً
					if cachedDemoClone then
						cachedDemoClone:Destroy()
						cachedDemoClone = nil
					end
					removeFakeDemoModel()

					-- 2. تنفيذ التنسيخ بعد التأكد من اكتمال تحكم السيرفر بالـ DemoBuild
					task.delay(0.1, function()
						if not sourceModel or not sourceModel.Parent then return end

						-- حلقة تأكيد استقرار عدد الأجزاء لمنع النقص عند البناء الكثيف
						local previousCount = -1
						local currentCount = #sourceModel:GetDescendants()
						local attempts = 0

						-- الانتظار طالما أن السيرفر ما زال يضيف أجزاء جديدة للموديل الاصلي
						while currentCount ~= previousCount and attempts < 5 do
							previousCount = currentCount
							task.wait(0.1) -- مهلة فحص استقرار الأجزاء
							if sourceModel and sourceModel.Parent then
								currentCount = #sourceModel:GetDescendants()
							end
							attempts = attempts + 1
						end

						-- بعد استقرار الأجزاء، نبدأ النسخ العميق
						if sourceModel and sourceModel.Parent then
							local newFake = dexStyleClone(sourceModel)
							if newFake and #newFake:GetChildren() > 0 then
								cachedDemoClone = newFake
								print("تم استنساخ الموديل كاملاً بدون نقص! عدد الأجزاء:", #cachedDemoClone:GetChildren())

								displayFakeDemo()
							end
						end
					end)
				end


