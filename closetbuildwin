								local ownerValue = child:FindFirstChild("Owner")
								local teammateValue = child:FindFirstChild("Teammate")

								local isOwner = ownerValue and ownerValue.Value == localPlayer
								local isTeammate = teammateValue and teammateValue.Value == localPlayer

								if isOwner or isTeammate then
									currentPlot = child
									break
								end
							end
						end
					end
				end)

				toggleJumpBox:GetPropertyChangedSignal("Text"):Connect(function()
					if not jumpState then return end
					local cleanText = toggleJumpBox.Text:gsub("[^%d%.]", "")
					toggleJumpBox.Text = cleanText

					toggleJumpBoxFixed.Text = cleanText
				end)

				toggleSpeedBox:GetPropertyChangedSignal("Text"):Connect(function()
					if not speedState then return end
					local cleanText = toggleSpeedBox.Text:gsub("[^%d%.]", "")
					toggleSpeedBox.Text = cleanText

					toggleSpeedBoxFixed.Text = cleanText
				end)

				toggleFlyBox:GetPropertyChangedSignal("Text"):Connect(function()
					if not flyState then return end

					local cleanText = toggleFlyBox.Text:gsub("[^%d%.]", "")
					toggleFlyBox.Text = cleanText

					toggleFlyBoxFixed.Text = cleanText

					setFlyState(false)
					setFlyState(true)
				end)
				
				buildSpeedBox_R:GetPropertyChangedSignal("Text"):Connect(function()
					local cleanText = buildSpeedBox_R.Text:gsub("[^%d%.]", "")
					buildSpeedBox_R.Text = cleanText

					buildSpeedBox_RFixed.Text = cleanText
				end)

				runService.Heartbeat:Connect(function()
					local human = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
					if not human then return end
					if jumpState and tonumber(toggleJumpBoxFixed.Text) then 
						human.UseJumpPower=true
						human.JumpPower=toggleJumpBoxFixed.Text
					end
					if speedState and tonumber(toggleSpeedBoxFixed.Text) then 
						human.WalkSpeed=toggleSpeedBoxFixed.Text
					end
					if flyState and tonumber(toggleFlyBoxFixed.Text) then 
						FLY_SPEED=toggleFlyBoxFixed.Text
					end
				end)
				
				revealBuildlbl_R.MouseButton1Click:Connect(function()
					revealBuildState=not revealBuildState
					if revealBuildState then 
						revealBuildTerm.BackgroundColor=BrickColor.White()	
						revealBuildTerm.ImageTransparency=0
					else
						revealBuildTerm.BackgroundColor3=Color3.fromRGB(86, 86, 86)
						revealBuildTerm.ImageTransparency=1
					end
				end)

				autoBuildlbl_R.MouseButton1Click:Connect(function()
					autoBuildState = not autoBuildState

					if autoBuildState then 
						autoBuildTerm.BackgroundColor = BrickColor.White() 
						autoBuildTerm.ImageTransparency = 0

						task.spawn(executeAutoBuild)
					else
						autoBuildTerm.BackgroundColor3 = Color3.fromRGB(86, 86, 86)
						autoBuildTerm.ImageTransparency = 1
					end
				end)

				flylbl_R.MouseButton1Click:Connect(function()
					flyState = not flyState
					setFlyState(flyState)
					if flyState then 
						flyTerm.BackgroundColor = BrickColor.White() 
						flyTerm.ImageTransparency = 0

						toggleFlylbl_LFixed.TextColor=BrickColor.White()
						toggleFlyBoxFixed.TextColor=BrickColor.White()
						toggleFlyBox.Active=true

					else
						flyTerm.BackgroundColor3 = Color3.fromRGB(86, 86, 86)
						flyTerm.ImageTransparency = 1

						toggleFlylbl_LFixed.TextColor=BrickColor.Gray()
						toggleFlyBoxFixed.TextColor=BrickColor.Gray()
						toggleFlyBox.Active=false
					end
				end)

				jumplbl_R.MouseButton1Click:Connect(function()
					jumpState = not jumpState

					if jumpState then 
						jumpTerm.BackgroundColor = BrickColor.White() 
						jumpTerm.ImageTransparency = 0

						toggleJumplbl_LFixed.TextColor=BrickColor.White()
						toggleJumpBoxFixed.TextColor=BrickColor.White()
						toggleJumpBox.Active=true

					else
						jumpTerm.BackgroundColor3 = Color3.fromRGB(86, 86, 86)
						jumpTerm.ImageTransparency = 1

						toggleJumplbl_LFixed.TextColor=BrickColor.Gray()
						toggleJumpBoxFixed.TextColor=BrickColor.Gray()
						toggleJumpBox.Active=false
					end
				end)

				speedlbl_R.MouseButton1Click:Connect(function()
					speedState = not speedState

					if speedState then 
						speedTerm.BackgroundColor = BrickColor.White() 
						speedTerm.ImageTransparency = 0

						toggleSpeedlbl_LFixed.TextColor=BrickColor.White()
						toggleSpeedBoxFixed.TextColor=BrickColor.White()
						toggleSpeedBox.Active=true

					else
						speedTerm.BackgroundColor3 = Color3.fromRGB(86, 86, 86)
						speedTerm.ImageTransparency = 1

						toggleSpeedlbl_LFixed.TextColor=BrickColor.Gray()
						toggleSpeedBoxFixed.TextColor=BrickColor.Gray()
						toggleSpeedBox.Active=false
					end
				end)

			end)
		end)
	end)
end

local function ExistingUI(name)
	for _, child in ipairs(uiParent:GetDescendants()) do
		if child:IsA("ScreenGui") and child.Name == name then
			return child
		end
	end
end

