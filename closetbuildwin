local function makeModelGhostly(model)
	if not model then return end

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Transparency = 0.5 -- درجة الشفافية (يمكنك تعديلها من 0 إلى 1)
			descendant.CanCollide = false  -- إلغاء التصادم الفيزياء
			descendant.CanTouch = false    -- إلغاء التفاعل بالأحداث (Touched)
			descendant.CanQuery = false    -- جعل الكاميرا والـ Raycasts والماوس يمرون من خلالها
		end
	end
end

local function fixedTxt(parent, siz, pos)
	parent.TextTransparency = 1

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(siz, 0, 0.8, 0)
	lbl.Position = UDim2.new(pos, 0, 0.1, 0)
	lbl.TextColor = BrickColor.new("White")
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(24, 24, 24)
	lbl.FontFace=Font.fromEnum(Enum.Font.Code)
	lbl.BackgroundTransparency = 1
	lbl.Text = parent.Text
	lbl.TextScaled = true
	lbl.Parent = parent
	return lbl
end

