				local function isPositionOnPlayerSide(targetPosition)
					if not currentPlot then return true end

					-- 1. البحث عن DuesWall داخل currentPlot
					local duesWall = nil
					for _, descendant in ipairs(currentPlot:GetDescendants()) do
						if descendant.Name == "DuosWall" and descendant:IsA("BasePart") and descendant.CanCollide == true then
							duesWall = descendant
							break
						end
					end

					-- إذا لم نجد الجدار أو كان CanCollide غير محدد، اسمح بالمعالجة الطبيعية
					if not duesWall then return true end

					local character = localPlayer.Character
					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					if not hrp then return true end

					-- 2. تحويل موقع اللاعب وموقع البلوك إلى الإحداثيات المحلية للجدار
					-- هذا يحول المحور X بالنسبة للجدار نفسه وليس العالم (World Space)
					local wallCFrame = duesWall.CFrame
					local playerLocalPos = wallCFrame:PointToObjectSpace(hrp.Position)
					local blockLocalPos = wallCFrame:PointToObjectSpace(targetPosition)

					-- 3. تطبيق هامش بسيط (Margin) بـ 0.5 لتنبأ بالبلوكات الملتصقة تماماً بالجدار
			
					local isPlayerPositive = playerLocalPos.X >= 0
					local isBlockPositive = blockLocalPos.X >= 0

					-- يجب أن يكون كلاهما في نفس الجهة (كلاهما موجبان أو كلاهما سالبان)
					return isPlayerPositive == isBlockPositive
				end
				
				local function isBlockCorrectInDemo(builtPart)
					if not fakeDemoModel then return true end -- لتجنب المسح العشوائي إذا لم يكن المخطط جاهزاً

					for _, descendant in ipairs(fakeDemoModel:GetDescendants()) do
						if descendant:IsA("BasePart") then
							-- فحص تقارب الموقع الفيزيائي بين البلوك المبني والبارت في المخطط
							if (descendant.Position - builtPart.Position).Magnitude < 0.1 then
