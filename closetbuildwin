								local dir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)

								-- تطبيق الدوران الأفقي فقط مع الحفاظ التام على موقعك الحالي وقوة الجاذبية
								if dir.Magnitude > 0.001 then
