				local function removeFakeDemoModel()
					if fakeDemoModel then
						fakeDemoModel:Destroy()
						fakeDemoModel = nil
						print("تم حذف النسخة المفبركة (Fake DemoBuild)")
					end
				end
				
				local function displayFakeDemo()
					if not revealBuildState or not currentPlot or not cachedDemoClone then return end
					if fakeDemoModel and fakeDemoModel.Parent == currentPlot then return end

					removeFakeDemoModel()

					cachedDemoClone.Archivable = true
					fakeDemoModel = cachedDemoClone:Clone()

					if fakeDemoModel then
						-- إعادة تثبيت الأجزاء وتأكيد أماكنها
						for _, part in ipairs(fakeDemoModel:GetDescendants()) do
							if part:IsA("BasePart") then
								part.Anchored = true
							end
						end

						fakeDemoModel.Parent = currentPlot
						print("تم إظهار الـ FakeDemoBuild مع كامل أبنائه وبمواقعهم الصحيحة!")
					end
				end
				
				local function cacheSourceModel(sourceModel)
					if not sourceModel then return end

					-- 1. تصفير الـ Cache القديم فوراً لمنع الكود من إظهاره مجدداً
					if cachedDemoClone then
						cachedDemoClone:Destroy()
						cachedDemoClone = nil
					end

					-- 2. تنفيذ التنسيخ العميق بطريقة Dex
					task.delay(0.1, function()
						if not sourceModel or not sourceModel.Parent then return end

						local newFake = dexStyleClone(sourceModel)
						if newFake and #newFake:GetChildren() > 0 then
							cachedDemoClone = newFake
							print("تم استنساخ الموديل الجديد بطريقة Dex بنجاح! عدد الأجزاء:", #cachedDemoClone:GetChildren())

							-- إظهار الموديل الجديد فور اكتمال تجهيزه إذا كانت الحالة مفعّلة
							if revealBuildState then
								displayFakeDemo()
							end
						end
					end)
				end

				
				runService.Heartbeat:Connect(function()
					-- 1. التأكد من وجود Plot مستقر
					if currentPlot then
						if not currentPlot.Parent or not currentPlot:IsDescendantOf(gameFolder) then
							currentPlot = nil
							realDemoModel = nil
							if cachedDemoClone then
								cachedDemoClone:Destroy()
								cachedDemoClone = nil
							end
							removeFakeDemoModel()
							print("تم مسح الـ Plot وجميع النسخ المخزنة.")
						else
							local foundDemo = currentPlot:FindFirstChild("DemoBuild")

							-- 2. فور ظهور DemoBuild أصلي جديد معروض من اللعبة
							if foundDemo and foundDemo ~= realDemoModel then
								print(true)
								removeFakeDemoModel()
								realDemoModel = foundDemo
								cacheSourceModel(realDemoModel)
							end

							-- 3. إدارة إظهار وإخفاء المزيف بناءً على revealBuildState
							if revealBuildState then
								if not fakeDemoModel and cachedDemoClone then
									displayFakeDemo()
								end
							else
								if fakeDemoModel then
									removeFakeDemoModel()
								end
							end
						end
					else
						if cachedDemoClone then
							cachedDemoClone:Destroy()
							cachedDemoClone = nil
						end
						removeFakeDemoModel()
					end

					-- 4. البحث عن Plot يملكه اللاعب عند عدم وجود Plot حالي
					if not currentPlot then
						for _, child in ipairs(gameFolder:GetChildren()) do
							if child:IsA("Model") and child.Name == "Plot" then
								local ownerValue = child:FindFirstChild("Owner")
								local teammateValue = child:FindFirstChild("Teammate")

								local isOwner = ownerValue and ownerValue.Value == localPlayer
								local isTeammate = teammateValue and teammateValue.Value == localPlayer

								if isOwner or isTeammate then
									currentPlot = child
									break
								end
							end
						end
					end
				end)
				
				revealBuildlbl_R.MouseButton1Click:Connect(function()
					revealBuildState=not revealBuildState
					if revealBuildState then 
						revealBuildTerm.BackgroundColor=BrickColor.White()	
						revealBuildTerm.ImageTransparency=0
					else
						revealBuildTerm.BackgroundColor3=Color3.fromRGB(86, 86, 86)
						revealBuildTerm.ImageTransparency=1
					end
				end)
				
				autoBuildlbl_R.MouseButton1Click:Connect(function()
					executeAutoBuild()
				end)

			end)
		end)
	end)
end

