local function forceEnableArchivable(model)
	model.Archivable = true
	for _, descendant in ipairs(model:GetDescendants()) do
		descendant.Archivable = true
	end
end

local function applyGhostProperties(descendant)
	if descendant:IsA("BasePart") then
		descendant.Transparency = 0.5
		descendant.CanCollide = false
		descendant.CanTouch = false
		descendant.CanQuery = false
	end
end

-- دالة تحويل الموديل كاملاً وأبنائه إلى أشباح
local function makeModelGhostly(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		applyGhostProperties(descendant)
	end

	-- التعامل مع الأجزاء التي قد تتزامن لاحقاً من السيرفر (Streaming)
	model.DescendantAdded:Connect(function(descendant)
		applyGhostProperties(descendant)
	end)
end

-- دالة استنساخ عميقة تطابق طريقة عمل Dex Explorer
local function dexStyleClone(sourceModel)
	if not sourceModel then return nil end

	-- 1. جمع كافة الأجزاء المطلوبة من المجسم الأصلي
	local sourceParts = {}
	for _, descendant in ipairs(sourceModel:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name ~= "Center" then
			table.insert(sourceParts, descendant)
		end
	end

	-- إذا كان المجسم فارغاً لحظة الاستدعاء، ننتظر كسر ثانية لإتاحة الفرصة للتحميل
	if #sourceParts == 0 then
		task.wait(0.05)
		for _, descendant in ipairs(sourceModel:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Name ~= "Center" then
				table.insert(sourceParts, descendant)
			end
		end
	end

	local fakeModel = Instance.new("Model")
	fakeModel.Name = "FakeDemoBuild"

	-- 2. تنفيذ النسخ مع التأكد من نقل كل جزء
	for i = 1, #sourceParts do
		local part = sourceParts[i]

		-- التأكد من أن البارت ما زال موجوداً داخل اللعبة ولم يُحذف
		if part and part.Parent then
			local partClone = part:Clone()
			if partClone then
				partClone.Transparency = 0.5
				partClone.CanCollide = false
				partClone.CanTouch = false
				partClone.CanQuery = false
				partClone.Anchored = true
				partClone.CFrame = part.CFrame
				partClone.Parent = fakeModel
			end
		end
	end

	return fakeModel
end

