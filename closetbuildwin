							-- الحالة الثانية: قفل أفقي حقيقي على TouchPart دون رفع أو خفض CFrame
							local touchPart = findTouchPart()

							if touchPart and touchPart:IsA("BasePart") and touchPart:IsDescendantOf(workspace) then
