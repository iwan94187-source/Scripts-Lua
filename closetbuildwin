							end
						end
					end
				end

				local function executeAutoBuild()
					if not fakeDemoModel then
						print("لا يوجد FakeDemoBuild معروض حالياً!")
						return
					end

					print("بدء عملية التنظيف والبناء التلقائي المستمر...")

					while autoBuildState and fakeDemoModel do
						-- 1. أولاً: حذف البلوكات الزائدة التي تقع في جهة اللاعب فقط
						executeAutoDestroy()

						-- 2. ثانياً: بناء البلوكات الناقصة الصحيحة في جهة اللاعب فقط
						for _, descendant in ipairs(fakeDemoModel:GetDescendants()) do
							if not autoBuildState then break end

							if descendant:IsA("BasePart") then
								local rawPosition = descendant.Position

								-- تجاهل أي جزء في المخطط يقع خلف الجدار بالنسبة للاعب
								if not isPositionOnPlayerSide(rawPosition) then
									continue
								end

								local partColor = descendant.Color

								if isBlockAlreadyBuilt(rawPosition) then
									continue
								end

								local matchedColor = getMatchingColorFromInventory(partColor)

								if matchedColor then
									local blockHeight = descendant.Size.Y
									local correctedPosition = rawPosition - Vector3.new(0, blockHeight, 0)

									placeBlockEvent:FireServer(
										correctedPosition,
										Enum.NormalId.Top,
										matchedColor
									)

									local rawSpeedNumber = tonumber(buildSpeedBox_RFixed.Text) or 10
									local waitDelay = math.max(0.01, rawSpeedNumber / 100)

									task.wait(waitDelay)
								end
							end
						end

						task.wait(0.5)
					end

					print("تم إيقاف البناء والتنظيف التلقائي.")
				end

				local function getMoveDirection(humanoid)
					local moveDir = humanoid.MoveDirection

					-- 1. فحص مفاتيح الكمبيوتر في حال عدم استخدام الجويستيك
					if moveDir.Magnitude == 0 then
						local forward = UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or (UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0)
						local right = UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or (UserInputService:IsKeyDown(Enum.KeyCode.A) and -1 or 0)

						if forward ~= 0 or right ~= 0 then
							local camCFrame = camera.CFrame
							moveDir = (camCFrame.LookVector * forward + camCFrame.RightVector * right)
						end
					else

						local camCFrame = camera.CFrame

						-- نأخذ متجهات الاتجاه الحقيقية للكاميرا (أمام/خلف ويمين/يسار)
						local forwardVector = camCFrame.LookVector
						local rightVector = camCFrame.RightVector

						-- نحول MoveDirection إلى اتجاه محلي بالنسبة للشخصية ثم نربطه بالكاميرا
						local rootPart = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
						if rootPart then
							-- نحول متجه الحركة العالمي إلى اتجاه محلي (Local Space)
							local localMove = rootPart.CFrame:VectorToObjectSpace(moveDir)

							-- نطبق الحركة محلياً بالنسبة لاتجات الكاميرا (الأمام/الخلف يسحبك مع ميلان الكاميرا للأعلى والأسفل)
							moveDir = (forwardVector * -localMove.Z) + (rightVector * localMove.X)
						end
					end

					return moveDir
				end

