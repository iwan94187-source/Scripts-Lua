					for _, descendant in ipairs(currentPlot:GetDescendants()) do
						if not autoBuildState then break end

						local isPlayerBlock = descendant.Name == "Block" and descendant:FindFirstChildOfClass("BoolValue")

						if isPlayerBlock then
							local targetPart = descendant:IsA("BasePart") and descendant or descendant:FindFirstChildWhichIsA("BasePart")

							if targetPart then
								-- 1. تجاهل البلوك إذا كان في الجهة المقابلة للجدار بالنسبة للاعب
								if not isPositionOnPlayerSide(targetPart.Position) then
									continue
								end

								-- 2. التحقق مما إذا كان البلوك خاطئاً (زائد أو بلون غير صحيح)
								if not isBlockCorrectInDemo(targetPart) then
