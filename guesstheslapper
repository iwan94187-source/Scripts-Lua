local function isPartInsidePart(partToTest, zonePart)
	if not partToTest or not zonePart then return false end

	local zoneCFrame = zonePart.CFrame
	local zoneSize = zonePart.Size
	local localPos = zoneCFrame:PointToObjectSpace(partToTest.Position)

	return math.abs(localPos.X) <= (zoneSize.X / 2) and
		math.abs(localPos.Y) <= (zoneSize.Y / 2) and
		math.abs(localPos.Z) <= (zoneSize.Z / 2)
end

local function safeClickDodge(targetButton)
	if not targetButton then return end

	-- 1. إطلاق الإشارات البرمجية مباشرة عبر المحاكي (firesignal)
	pcall(function()
		if firesignal then
			firesignal(targetButton.MouseButton1Click)
			firesignal(targetButton.MouseButton1Down)
			firesignal(targetButton.Activated)
			firesignal(targetButton.InputBegan, {UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin})
		elseif getconnections then
			for _, conn in ipairs(getconnections(targetButton.MouseButton1Click)) do conn:Fire() end
			for _, conn in ipairs(getconnections(targetButton.MouseButton1Down)) do conn:Fire() end
			for _, conn in ipairs(getconnections(targetButton.Activated)) do conn:Fire() end
		end
	end)

	-- 2. إرسال الضغطات الفعلية (Touch & Mouse) بدون تأخير
	task.spawn(function()
		local pos = targetButton.AbsolutePosition
		local size = targetButton.AbsoluteSize
		local x = pos.X + (size.X / 2)
		local y = pos.Y + (size.Y / 2) + 36

		-- ضغطة ماوس
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)

		-- ضغطة لمس (مهمة للهواتف لتفعيل زر تفادي اللعبة)
		VirtualInputManager:SendTouchEvent(0, 0, x, y)
		VirtualInputManager:SendTouchEvent(0, 2, x, y)
	end)
end


