RunService.Heartbeat:Connect(function()
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then 
		return 
	end

	local myRoot = myChar.HumanoidRootPart

	local currentMyArena = nil

	for _, child in ipairs(areanasFolder:GetChildren()) do
		if child:IsA("Model") and (child.Name:lower() == "arena") then
			local isInside = false
			local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
			if primaryPart then
				local cframe, size = child:GetBoundingBox()
				local localPos = cframe:PointToObjectSpace(myRoot.Position)
				if math.abs(localPos.X) <= (size.X / 2) and
					math.abs(localPos.Y) <= (size.Y / 2) and
					math.abs(localPos.Z) <= (size.Z / 2) then
					isInside = true
				end
			end

			if isInside then
				currentMyArena = child
				break
			end
		end
	end

	if currentMyArena then
		
		local slaptp = currentMyArena:FindFirstChild("slaptp")
		local chair = currentMyArena:FindFirstChild("Chair")
		local seat = chair and chair:FindFirstChild("Seat")
		local mainCam = currentMyArena:FindFirstChild("maincam")
		local blocks = currentMyArena:FindFirstChild("blocks")
		if meter then
			if not meter.Visible then 
				useSlap=true
			end
		end
		
		if slaptp and slaptp:IsA("BasePart") then
			local foundPlayer = nil

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
						local otherRoot = player.Character.HumanoidRootPart
						if isPartInsidePart(otherRoot, slaptp) then
							foundPlayer = player
							break
						end
					end
				else
					if autoSlapState then
						if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local otherRoot = player.Character.HumanoidRootPart
							if isPartInsidePart(otherRoot, slaptp) then
								if useSlap then
									useSlap=false
									sendSlapEvent:FireServer(tonumber(valueLabel))
								end
									
								
							end
							
						end
					end
					
				end
			end

			if foundPlayer then
				
				if autoGuessState and suspk and suspk.Visible then 
					guessEvent:FireServer(foundPlayer.Name)
				end
				-- التأكد من أن الزوم/الزر ظاهر ومفعل (AbsoluteSize > 0)
				if autododgeState then
					
					dodgeEvent:FireServer(true)
					--safeClickDodge(dodgeBtn)
				end
			else
				if turnSlapState then
					if slapbut.Visible then 
						slapTurn:FireServer()
					else
					end
				else
				end
			end

		end
	end
end)

