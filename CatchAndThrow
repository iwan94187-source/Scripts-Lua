local function findKnife(parent)
	for _, desc in ipairs(parent:GetDescendants()) do
		if desc.Name == "Knife" or desc.Name == "TouchPart" then
			return desc
		end
	end
	return nil
end

local KnifeFounded = nil
-- 2. الاتصال بالمسار والمراقبة
runService.Heartbeat:Connect(function()
	local knifeSpawner = arena:FindFirstChild("KnifeSpawner")
	if not knifeSpawner then
		KnifeFounded=nil
		return
	end

	-- فحص أولي إذا كانت السكين موجودة مسبقاً
	local foundKnife = findKnife(knifeSpawner)
	if foundKnife then
		KnifeFounded=foundKnife
