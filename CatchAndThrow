-- 4. منطق السحب والتمدد (Slider Logic)
local dragging = false

local function updateSlider(input)
	-- حساب موقع الإصبع/الموس بالنسبة لطول الخط
	local mousePos = input.Position.X
	local sliderPos = sliderBack.AbsolutePosition.X
	local sliderSize = sliderBack.AbsoluteSize.X

	-- حصار القيمة بين 0 و 1 (من بداية الخط لنهايته)
	local percentage = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)

	-- تحريك الزر بصرياً
	knob.Position = UDim2.new(percentage, -10, 0.5, -8)

	-- تحويل النسبة لقيمة (مثلاً من 1 إلى 50 استود للمسافة)
	local value = math.floor(percentage * 50) 
	valueLabel.Text = tostring(value)

	return value
end

local function getTargetButton()
	local hud = PlayerGui:FindFirstChild("HUD")
	if hud then
		local mobileButtons = hud:FindFirstChild("MobileButtons")
		if mobileButtons then
			local catchFrame = mobileButtons:FindFirstChild("Catch")
			if catchFrame then
				return catchFrame:FindFirstChild("click")
			end
		end
	end
	return nil
end

local function getClosestPlayer()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local closestPlayer = nil
	local shortestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character

			-- 1. فحص التأكد من أن الشخصية داخل الـ Workspace وليست محذوفة أو مخفية
			if char:IsDescendantOf(workspace) then
				local targetRoot = char:FindFirstChild("HumanoidRootPart")
				local targetHumanoid = char:FindFirstChildOfClass("Humanoid")
				local head = char:FindFirstChild("Head")

				-- 2. شروط صارمة: حي + الرأس موجود + الجسد غير شفاف بالكامل (ليس جثة/لاعب وهمي)
				if targetRoot and targetHumanoid and targetHumanoid.Health > 0 and head then
					if targetRoot.Transparency < 1 or head.Transparency < 1 then
						local dist = (myRoot.Position - targetRoot.Position).Magnitude

						-- 3. تحديد أقصى مسافة للقفل (مثلاً 250 استود) لمنع الالتفاف المفاجئ لزوايا بعيدة
						if dist < shortestDistance and dist <= 250 then
							shortestDistance = dist
							closestPlayer = player
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

-- 3. دالة محاكاة ضغط الزر
local function clickButton(btn)
	if not btn then return end

	if firesignal then
		pcall(function() firesignal(btn.MouseButton1Click) end)
		pcall(function() firesignal(btn.MouseButton1Down) end)
		pcall(function() firesignal(btn.Activated) end)
		pcall(function() firesignal(btn.TouchTap) end)
	end

	if game:GetService("VirtualInputManager") then
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
			vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
			task.wait(0.02)
			vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
		end)
	end
end

-- 4. دالة البحث عن TouchPart داخل Model
local function findTouchPart()
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and child.Name == "Model" then
			local touchPart = child:FindFirstChild("TouchPart", true)
			if touchPart and touchPart:IsA("BasePart") then
				return touchPart
			end
		end
	end
	return nil
end

local function getActiveTouchZone()
	local mxx = workspace:FindFirstChild("Scripttable")
	if not mxx then return nil end
	
	local arena = mxx:FindFirstChild("Arena")
	if not arena then return nil end

	local knifeSpawner = arena:FindFirstChild("KnifeSpawner")
	if not knifeSpawner then return nil end

	local stands = knifeSpawner:FindFirstChild("Stands")
	if not stands then return nil end

	-- استخدام Loop للبحث داخل جميع الموديلات المترقمة داخل Stands
	for _, standModel in ipairs(stands:GetChildren()) do
		if standModel:IsA("Model") then
			local touchZone = standModel:FindFirstChild("TouchZone")

			-- الشرط: وجود TouchZone + يملك كائنات أبناء بداخله (#GetChildren > 0)
			if touchZone and touchZone:IsA("BasePart") and #touchZone:GetChildren() > 0 then
				return touchZone
			end
		end
	end

	return nil
end

