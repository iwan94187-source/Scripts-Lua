runService.Heartbeat:Connect(function()
	-- 1. التأكد من تفعيل الميزة ووجود السكين
	if not GetKnifeState or not KnifeFounded then return end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

	-- 2. التأكد من أن الشخصية حية والسكين ما زال موجوداً في الـ Workspace
	if myRoot and myHumanoid and myHumanoid.Health > 0 and KnifeFounded:IsDescendantOf(workspace) then
		-- جلب موقع السكين
		local targetCFrame = nil

		if KnifeFounded:IsA("BasePart") then
			targetCFrame = KnifeFounded.CFrame
		elseif KnifeFounded:IsA("Model") then
			targetCFrame = KnifeFounded:GetPivot()
		end

		-- 3. نقل الشخصية فوراً إلى موقع السكين
		if targetCFrame then
			myRoot.CFrame = targetCFrame
		end
	end
end)
