-- دالة CFrame أفقية تماماً تلغي تأثير المحور Y
local function getFlatLookCFrame(myPos, targetPos)
	-- تجاهل ارتفاع الهدف وجعله على نفس مستوى ارتفاع شخصيتك تماماً
	local flatTargetPos = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)

	-- حماية بسيطة في حال كان الهدف وقوفاً على نفس إحداثياتك بالضبط
	local dir = (flatTargetPos - myPos)
	if dir.Magnitude < 0.001 then
		return CFrame.new(myPos)
	end

	return CFrame.lookAt(myPos, flatTargetPos)
end

runService.Heartbeat:Connect(function()
	if not LockPlayerState then return end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

	if myRoot and myHumanoid and myHumanoid.Health > 0 then
		local rightArm = myChar:FindFirstChild("Right Arm") or myChar:FindFirstChild("RightHand")
		local rightGrip = rightArm and rightArm:FindFirstChild("RightGrip")

		if rightGrip then
			-- الحالة الأولى: وجود RightGrip -> القفل الأفقي على أقرب لاعب
			local closest = getClosestPlayer()

			if closest and closest.Character then
				local targetChar = closest.Character
				local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

				if targetHum and targetHum.Health > 0 and targetChar:IsDescendantOf(workspace) then
					local targetPart = targetChar:FindFirstChild("HumanoidRootPart") 
						or targetChar:FindFirstChild("Torso") 
						or targetChar:FindFirstChild("UpperTorso")

					if targetPart and targetPart:IsA("BasePart") then
						-- دمج التوجيه الأفقي مع تثبيت المستوى على المحور Y
						myRoot.CFrame = getFlatLookCFrame(myRoot.Position, targetPart.Position)
					end
				end
			end
		else
			-- الحالة الثانية: عدم وجود RightGrip -> القفل الأفقي على TouchPart
			local touchPart = findTouchPart()

			if touchPart and touchPart:IsA("BasePart") and touchPart:IsDescendantOf(workspace) then
				myRoot.CFrame = getFlatLookCFrame(myRoot.Position, touchPart.Position)
			end
		end
	end
end)

runService.Heartbeat:Connect(function()
	if not GetKnifeState or cooldown2 then return end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if myRoot then
		local targetZone = getActiveTouchZone()

		if targetZone then
			cooldown2 = true

			-- نقل الشخصية إلى موقع الجزء المباشر مع رفع الموقع قليلاً لتجنب السقوط داخل الأرﺽ
			myRoot.CFrame = targetZone.CFrame + Vector3.new(0, 3, 0)
