local function newBtn(name, pos, parent)
	local btn = Instance.new("TextButton")
	btn.Size=UDim2.new(1,0,0,25)
	btn.Position=UDim2.new(0,0,pos,0)
	btn.Text=name
	btn.TextScaled=true
	btn.TextXAlignment="Left"
	btn.TextColor=BrickColor.new("White")
	btn.BackgroundColor3=Color3.new(0.164706, 0.164706, 0.164706)
	btn.Parent=parent
	return btn
end

local function newTrem(parent)
	local trem = Instance.new("TextLabel")
