local currentCrawlTrack = nil

crawlBtn.MouseButton1Click:Connect(function()
	crawlState = not crawlState
	local mapX = nil
	local char = player.Character
	local human = char and char:FindFirstChildOfClass("Humanoid")
	local animator = human and human:FindFirstChildOfClass("Animator")
	local animFolder = replicate:FindFirstChild("Animations")

	if crawlState then 
		-- تفعيل الزحف
		
		if human then 
			human.HipHeight = -2
		end

		if animator and animFolder then 
			local crawlAnim = animFolder:FindFirstChild("AnimCrawl")
			if crawlAnim then 
				-- تحميل الأنيميشن وتشغيله
				currentCrawlTrack = animator:LoadAnimation(crawlAnim)
				currentCrawlTrack:Play()
			end
		end

		crawlTerm.Text = "🟢"
	else 
		-- إيقاف الزحف
		if human then 
			human.HipHeight = 0 -- إرجاع الارتفاع الطبيعي
		end

		if currentCrawlTrack then 
			currentCrawlTrack:Stop() -- إيقاف الأنيميشن المحمل
			currentCrawlTrack = nil
		end

		crawlTerm.Text = "🔴"
	end
end)

