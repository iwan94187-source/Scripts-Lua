local function destroyVentBlocks(parentObject)
	if not parentObject then return end

	-- GetDescendants تقوم بجلب كافة الأبناء والأحفاد داخل العنصر
	for _, descendant in ipairs(parentObject:GetDescendants()) do
		if descendant.Name == "VentBlock" then
			descendant:Destroy()
		end
	end
end

