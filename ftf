local function UIcorner(ui, lTop, rTop, lBtm, rBtm) 
	local uiCorner = Instance.new("UICorner")
	uiCorner.TopLeftRadius = UDim.new(0, rTop)
	uiCorner.TopRightRadius = UDim.new(0,lTop)
	uiCorner.BottomLeftRadius = UDim.new(0, rBtm)
	uiCorner.BottomRightRadius = UDim.new(0,lBtm)
	uiCorner.Parent = ui

	-- 4. إطار خارجي رمادي خفيف للتمييز (اختياري)
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = Color3.fromRGB(40, 40, 40)
	uiStroke.Thickness = 1.5
	uiStroke.Parent = ui
	return uiCorner
end 

