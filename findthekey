local function getdescents(target)
	for _, dex in ipairs(target:GetDescendants()) do 
		if dex:IsA("ClickDetector") then 
			pcall(function()
				fireclickdetector(dex)
			end)

			task.wait(0.1) 
		elseif dex:IsA("ProximityPrompt") and dex.Enabled then 
			print("Firing Prompt via Dex method:", dex:GetFullName())

			pcall(function()
				-- تحديد أقصى مدة انتظار لمنع تعليق السكربت
				local holdTime = math.min(dex.HoldDuration or 0, 2)

				dex:InputHoldBegin()
				if holdTime > 0 then
					task.wait(holdTime + 0.02)
				else
					task.wait(0.02)
				end
				dex:InputHoldEnd()
			end)

			task.wait(0.1) 
		end
	end
end

local function getDoors(doorFolder)
	for _, dex in ipairs(doorFolder:GetDescendants()) do 
		if dex:IsA("ProximityPrompt") then 
			pcall(function()
				fireproximityprompt(dex)
			end)

			task.wait(0.1) 
		end
	end
end

local function fixedTxt(parent, siz, pos)
	parent.TextTransparency = 1

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(siz, 0, 0.8, 0)
	lbl.Position = UDim2.new(pos, 0, 0.1, 0)
	lbl.TextColor = BrickColor.new("White")
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(24, 24, 24)
	lbl.FontFace=Font.fromEnum(Enum.Font.Code)
	lbl.BackgroundTransparency = 1
	lbl.Text = parent.Text
	lbl.TextScaled = true
	lbl.Parent = parent
	return lbl
end

