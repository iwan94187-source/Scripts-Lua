local function fixedTitleText(parent)
	parent.TextTransparency = 1 -- إخفاء النص الأصل
	-- 2. النص الأساسي (Main Title Label)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.8, 0, 0.8, 0)
	lbl.Position = UDim2.new(0.05, 0, 0.1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = parent.Text
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(15, 15, 15)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = parent

	-- 3. تدرج ألوان أسطوري (UIGradient)
	local gradient = Instance.new("UIGradient")
	-- تدرج ناري ذهبي (يمكنك تغيير الألوان حسب رغبتك)
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 83, 83)), -- ذهبي فاتح من الأعلى
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))    -- برتقالي دافئ من الأسفل
	}
	gradient.Rotation = 90 -- تدرج من الأعلى للأسفل
	gradient.Parent = lbl

	return lbl
end

