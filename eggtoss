local PlayerModule = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local function forceDynamicControl()
	-- 1. فرض نمط الحركة الديناميكية
	LocalPlayer.DevTouchMovementMode = Enum.DevTouchMovementMode.DynamicThumbstick

	-- 2. إجبار نظام التحكم البرمجي على التفعيل (Enable)
	if Controls then
		Controls:Enable(true)
	end

	-- 3. إظهار واجهات اللمس وإعادة تفعيلها في PlayerGui
	local touchGui = PlayerGui:FindFirstChild("TouchGui")
	if touchGui then
		touchGui.Enabled = true
		local touchControlFrame = touchGui:FindFirstChild("TouchControlFrame")
		if touchControlFrame then
			touchControlFrame.Visible = true

			local dynamicThumbstick = touchControlFrame:FindFirstChild("DynamicThumbstickFrame")
			if dynamicThumbstick then
				dynamicThumbstick.Visible = true
			end
		end
	end
end

runService.Stepped:Connect(function()
	if noClipState and LocalPlayer.Character then
		for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
	if moveState then
		forceDynamicControl()
	end
	if antiLavaState then 
		local lava = workspace:FindFirstChild("lava") or workspace:FindFirstChild("Lava")
		if lava then lava.CanTouch=false else lava.CanTouch=true end
	end
end)

runService.Heartbeat:Connect(function()
	if upState then 
		local human = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		if human then 
			if tonumber(speedBox.Text) then 
				human.WalkSpeed=speedBox.Text
			end
			if tonumber(jumpBox.Text) then 
				human.UseJumpPower=true
				human.JumpPower=jumpBox.Text
			end
		end
	end
end)

local flingPart = nil

local function setupFlingPart()
	if flingPart and flingPart.Parent then return end

	flingPart = Instance.new("Part")
	flingPart.Name = "TouchFlingEngine"
	flingPart.Size = Vector3.new(3, 3, 3)
	flingPart.Transparency = 1
	flingPart.CanCollide = false
	flingPart.Anchored = false
	flingPart.CanQuery = false
	flingPart.Parent = workspace
end

runService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if not flingState or not hrp or not hum or hum.Health <= 0 then
		if flingPart then
			flingPart:Destroy()
			flingPart = nil
		end
		return
	end

	setupFlingPart()

	if flingPart then
		-- 1. تثبيت وحماية شخصيتك لمنع طيرانك مطلقاً
		hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		-- 2. إعطاء الجزء قوة دفع فائقة
		flingPart.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
		flingPart.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)

		local targetFound = false

		-- 3. البحث عن أي شخصية أو NPC قريب
		for _, targetModel in ipairs(workspace:GetChildren()) do
			if targetModel:IsA("Model") and targetModel ~= char then
				local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
				local targetHrp = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso")

				if targetHum and targetHrp and targetHum.Health > 0 then
					local distance = (hrp.Position - targetHrp.Position).Magnitude

					-- عند الاقتراب (اقل من 5 أمتار)
					if distance <= 5 then
						targetFound = true
						-- نقل الجزء التخيلي فقط إلى موقع الخصم لضربه بالقوة
						flingPart.CFrame = targetHrp.CFrame
						break
					end
				end
			end
		end

		-- إذا لم تكن قريباً من أحد، يظل الجزء عند موقعك دون الاصطدام بك
		if not targetFound then
			flingPart.CFrame = hrp.CFrame * CFrame.new(0, -10, 0) -- إخفاء الجزء أسفل الأرض عند عدم الاستخدام
		end
	end
end)

