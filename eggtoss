local UserInputService = game:GetService("UserInputService")
local PlayerModule = require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local isDesktop = UserInputService.KeyboardEnabled and UserInputService.MouseEnabled

local function forceDynamicControl()
	if isDesktop then
		if Controls then
			Controls:Enable(true)
		end
	else
		-- 2. للهواتف / Touch: فرض نمط الحركة الديناميكية
		LocalPlayer.DevTouchMovementMode = Enum.DevTouchMovementMode.DynamicThumbstick

		if Controls then
			Controls:Enable(true)
		end

		-- إظهار واجهات اللمس
		local touchGui = PlayerGui:FindFirstChild("TouchGui")
		if touchGui then
			touchGui.Enabled = true
			local touchControlFrame = touchGui:FindFirstChild("TouchControlFrame")
			if touchControlFrame then
				touchControlFrame.Visible = true

				local dynamicThumbstick = touchControlFrame:FindFirstChild("DynamicThumbstickFrame")
				if dynamicThumbstick then
					dynamicThumbstick.Visible = true
				end
			end
		end
	end
end

runService.Stepped:Connect(function()
	if noClipState and LocalPlayer.Character then
		if LocalPlayer.Character:FindFirstChild("Humanoid") and not LocalPlayer.Character.Humanoid.Sit then
			for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
	if moveState then
		forceDynamicControl()
	end
	if antiLavaState then 
		local lava = workspace:FindFirstChild("lava") or workspace:FindFirstChild("Lava")
		if lava then lava.CanTouch=false else lava.CanTouch=true end
	end
	if lowGravityState then 
		if not bool then 
			usePotionEvent:FireServer("lowGravity", true)
		end
	end
end)

runService.Heartbeat:Connect(function()
	if upState then 
		speedSlideBtn.Visible,jumpBtn.Visible=true,true
		local human = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		if human then 
			if tonumber(speedBox.Text) then 
				human.WalkSpeed=speedBox.Text
			end
			if tonumber(jumpBox.Text) then 
				human.UseJumpPower=true
				human.JumpPower=jumpBox.Text
			end
		end
	end
	if maxZoomState then
		LocalPlayer.CameraMaxZoomDistance = 100000

		LocalPlayer.CameraMinZoomDistance = 0.5
	else
		LocalPlayer.CameraMaxZoomDistance = 128
		LocalPlayer.CameraMinZoomDistance = 10
	end
end)

-- 2. دالة تحديث حالة الريموت
local function updateStepBackState(enabled)
	anitBackState = enabled

	-- تعطيل أو تفعيل جميع الـ Connections المربوطة بالحدث
	if getconnections then
		for _, connection in ipairs(getconnections(StepBackEvent.OnClientEvent)) do
			if enabled then
				connection:Disable() -- حظر الريموت
			else
				connection:Enable()  -- إرجاع الريموت للعمل الطبيعي
			end
		end
	end
end

