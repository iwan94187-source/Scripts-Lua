	btn.BackgroundTransparency=0.5
	btn.BorderSizePixel=1
	btn.BorderColor3=Color3.fromRGB(86, 86, 86)
	btn.Text=name
	btn.Parent=parent
	return btn
end
				
local function newTerm(parent)
	local term = Instance.new("ImageLabel")
	term.Size=UDim2.new(0,15,0,15)
	term.Position=UDim2.new(0.05,0,0.1,0)
	term.BackgroundColor3=Color3.fromRGB(64, 64, 64)
	term.Image="rbxassetid://79837885108596"
	term.ImageTransparency=1
	term.Parent=parent
					
	return term
end

