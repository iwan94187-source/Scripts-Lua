local function fixedTxt(parent, siz, pos)
	parent.TextTransparency = 1

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(siz, 0, 0.8, 0)
	lbl.Position = UDim2.new(pos, 0, 0.1, 0)
	lbl.TextColor = BrickColor.new("White")
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.fromRGB(24, 24, 24)
	lbl.BackgroundTransparency = 1
	lbl.Text = parent.Text
	lbl.TextScaled = true
	lbl.Parent = parent
	return lbl
end

local function newlbl(name,parent)
	local lbl = Instance.new("TextLabel")
	lbl.Size=UDim2.new(0.5,0,0.05,0)
	lbl.Position=UDim2.new()
	lbl.BackgroundColor3=Color3.fromRGB(24, 24, 24)
	lbl.BackgroundTransparency=0.5
	lbl.BorderSizePixel=1
	lbl.BorderColor3=Color3.fromRGB(86, 86, 86)
	lbl.Text=name
	lbl.Parent=parent
	return lbl
end

local function newbtn(name,parent)
	local btn = Instance.new("TextButton")
	btn.Size=UDim2.new(0.5,0,0.05,0)
	btn.Position=UDim2.new(0.5)
	btn.BackgroundColor3=Color3.fromRGB(24, 24, 24)
	btn.BackgroundTransparency=0.5
	btn.BorderSizePixel=1
	btn.BorderColor3=Color3.fromRGB(86, 86, 86)
	btn.Text=name
	btn.Parent=parent
	return btn
end

