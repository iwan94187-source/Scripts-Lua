iconFrame.MouseButton1Click:Connect(function()
	local oldpos = iconFrame.Position
	local targetPos = UDim2.new(iconFrame.Position.X.Scale, iconFrame.Position.X.Offset + 20, iconFrame.Position.Y.Scale, iconFrame.Position.Y.Offset + 20)
	local iconMotion = tweenService:Create(iconFrame,TweenInfo.new(0.3),{Size=UDim2.new(),Position=targetPos})
	iconMotion:Play()
	iconMotion.Completed:Connect(function()
		iconFrame.Visible=false
		mainFrame.Visible=true
		mainFrame.Position=oldpos
		local frameMotion = tweenService:Create(mainFrame,TweenInfo.new(0.4),{Size=mainFrame_pos})
		frameMotion:Play()
	end)
	
end)

hideMenuBtn.MouseButton1Click:Connect(function()
	if blackFrame.Visible then return end
	menuAppearState=true
	local frameMotion = tweenService:Create(mainFrame,TweenInfo.new(0.4),{Size=UDim2.new(0,0,0,0)})
	frameMotion:Play()
	frameMotion.Completed:Connect(function()
		mainFrame.Visible = false

		-- 1. الموضع النهائي الذي نريد أن تستقر فيه الأيقونة (موضع القائمة)
		local finalPos = mainFrame.Position

		-- 2. حساب موضع البداية (بحيث يكون الحجم 0 في منتصف الموضع النهائي تماماً)
		local startPos = UDim2.new(
			finalPos.X.Scale, finalPos.X.Offset + (iconFrame_pos.X.Offset / 2),
			finalPos.Y.Scale, finalPos.Y.Offset + (iconFrame_pos.Y.Offset / 2)
		)

		-- 3. ضبط الأيقونة على موضع البداية وحجم 0 قبل الإظهار
		iconFrame.Size = UDim2.new(0, 0, 0, 0)
		iconFrame.Position = startPos
		iconFrame.Visible = true

		-- 4. التكبير والانزلاق إلى الموضع النهائي المحدد بنفس الوقت ليعطي تأثير التكبير من المنتصف
		local iconMotion = tweenService:Create(iconFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = iconFrame_pos,
			Position = finalPos
		})
		iconMotion:Play()
	end)
end)

