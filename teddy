				local char = player.Character
				if char then
					local color=getColor(char)
					for _, item in ipairs(char:GetChildren()) do 
						if item:IsA("Highlight") then 
							IsHold=true 
							break
						end
					end
					if not IsHold then newOutline(char,color[1], color[2]) end
				end
			end
		end
		espPlayerTerm.Position=UDim2.new(1,-10,0.5,-8)
		espPlayerPlate.BackgroundColor3=Color3.fromRGB(255, 255, 255)
	else 
		for _, player in ipairs(Players:GetPlayers()) do 
			if player~=LocalPlayer then 
				local char = player.Character
				if char then 
					for _, item in ipairs(char:GetChildren()) do 
						if item:IsA("Highlight") then item:Destroy() end
					end
				end
			end
		end
		espPlayerTerm.Position=UDim2.new(0,-10,0.5,-8)
		espPlayerPlate.BackgroundColor3=Color3.fromRGB(24, 24, 24)
	end
end)

