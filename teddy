runService.Heartbeat:Connect(function()
	local currentTime = os.clock()

	if gameFolder and (currentTime - lastCheckTime) >= checkInterval then
		lastCheckTime = currentTime

		local newItemsList = {}

		-- 1. جمع العناصر مع استبعاد جميع شخصيات اللاعبين
		for _, enum in ipairs(gameFolder:GetChildren()) do
			if not isPlayerCharacter(enum) then
				if enum:IsA("Folder") then
					local itemFolder = enum:FindFirstChild("Item") or enum:FindFirstChild("Items")
					if itemFolder then
						for _, item in ipairs(itemFolder:GetDescendants()) do
							if item and item.Parent and (item:IsA("BasePart") or item:IsA("UnionOperation")) then
								if not isPlayerCharacter(item) then
									table.insert(newItemsList, item)
								end
							end
						end
					end
				elseif enum:IsA("Model") and enum.Name ~= "Honey" then
					for _, item in ipairs(enum:GetDescendants()) do
						if item and item.Parent and (item:IsA("BasePart") or item:IsA("UnionOperation")) then
							if not isPlayerCharacter(item) then
								table.insert(newItemsList, item)
							end
						end
					end
				end
			end
		end

		-- 2. تنظيف الأزرار السابقة
		for _, child in ipairs(scroll_2:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		items = newItemsList

		-- 🎯 إعدادات قياسات الأزرار بالبكسل الثابت لضمان التمرير الممتاز
		local buttonHeight = 30 -- ارتفاع الزر الواحد بالبكسل
		local buttonSpacing = 5 -- المسافة بين كل زر والآخر بالبكسل

		-- 3. بناء الأزرار وحساب مواقعها بالبكسل
		for index, item in ipairs(items) do
			local nam = item.Name

			if item.BrickColor.Name == "Really black" then 
				nam = "o|Key[Black]"
			elseif item.BrickColor.Name == "Bright yellow" then 
				nam = "o|Key[Yellow]"
			elseif item.BrickColor.Name == "Bright blue" then 
				nam = "o|Key[Blue]"
			elseif item.BrickColor.Name == "Bright red" then 
				nam = "o|Key[Red]"
			elseif item.BrickColor.Name == "Carnation pink" then 
				nam = "o|Key[Pink]"
			elseif item.BrickColor.Name == "White" then
				nam = "o|Key[White]"
			elseif item.BrickColor.Name == "Teal" then 
				nam = "o|Key[Light-Blue]"
			elseif item.BrickColor.Name == "Toothpaste" then 
				nam = "◊|Key[Light-Blue]"
			elseif item.BrickColor.Name == "Magenta" then 
				nam = "o|Key[Purple]"
			elseif item.BrickColor.Name == "Lime green" then 
				nam = "o|Key[Green]"
			elseif item.BrickColor.Name == "Lapis" then 
				nam = "◊|Key[Blue]" 
			elseif item.BrickColor.Name == "Neon orange" then 
				nam = "◊|Key[Orange]" 
			elseif item.BrickColor.Name == "Really blue" then 
				nam = "◊|Key[Blue]"
			elseif item.BrickColor.Name == "Dark green" then 
				nam = "◊|Key[Dark Green]"
			elseif item.BrickColor.Name == "Cyan" then 
				nam = "◊|Key[Cyan]"
			elseif item.BrickColor.Name == "Institutional white" and item.Parent.Name ~= "Code" then 
				nam = "◊|Key[Cyan]"
			end

			-- حساب موقع الزر العمودي بالبكسل
			local yOffset = (index - 1) * (buttonHeight + buttonSpacing)

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0.8, 0, 0, buttonHeight)
			btn.Position = UDim2.new(0.1, 0, 0, yOffset)
			btn.Text = nam
			btn.BackgroundColor3 = gry
			btn.TextColor = BrickColor.new("White")
			btn.TextScaled = true
			btn.Parent = scroll_2
			newUi(btn)

			btn.MouseButton1Click:Connect(function()
				if item and item.Parent then
					local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
					local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
					local humanoid = myChar and myChar:FindFirstChildWhichIsA("Humanoid")
					local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

					local targetObject = nil
					local current = item

					while current and current ~= workspace do
						if CollectionService:HasTag(current, "Item") or CollectionService:HasTag(current, "EasterChick") or current:FindFirstChild("Origin") then
							targetObject = current
							break
						end
						current = current.Parent
					end

					targetObject = targetObject or item.Parent

					if root and targetObject then
						local oldCFrame = root.CFrame

						-- 🎯 1. دالة حساب إجمالي الأغراض (تأخذ Tool و Model في الحقيبة والشخصية)
						local function getItemCount()
							local count = 0
							if backpack then
								for _, child in ipairs(backpack:GetChildren()) do
									if child:IsA("Tool") or child:IsA("Model") then
										count = count + 1
									end
								end
							end
							if myChar then
								for _, child in ipairs(myChar:GetChildren()) do
									if child:IsA("Tool") or child:IsA("Model") then
										count = count + 1
									end
								end
							end
							return count
						end

						local initialCount = getItemCount()

						-- 2. النقل إلى موقع العنصر
						root.CFrame = item.CFrame

						-- 3. إرسال طلب التفاعل للسيرفر
						if CollectionService:HasTag(targetObject, "EasterChick") then
							interactEvent:FireServer(targetObject, "EasterChick")
						else
							interactEvent:FireServer(targetObject, "Item")
						end

						-- 🎯 4. الانتظار الذكي الفوري: يتحقق من زيادة العدد الكلي للأغراض بغض النظر عن نوعها
						local timeout = 0
						while timeout < 1.0 do
							-- أ) اختفاء العنصر من الخريطة
							if not (item and item.Parent and item:IsDescendantOf(workspace)) then
								break
							end

							-- ب) زيادة في عدد الأغراض لدى اللاعب
							if getItemCount() > initialCount then
								break
							end

							-- إعادة التنبيه للسيرفر عند التأخر
							if timeout >= 0.2 and (math.floor(timeout * 100) % 20 == 0) then
								if CollectionService:HasTag(targetObject, "EasterChick") then
									interactEvent:FireServer(targetObject, "EasterChick")
								else
									interactEvent:FireServer(targetObject, "Item")
								end
							end

							task.wait(0.02)
							timeout = timeout + 0.02
						end

						-- 5. العودة الفورية للموقع الأصلي وإعادة الضبط
						root.CFrame = oldCFrame
						root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

						if humanoid then
							humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
						end
					end
				end
			end)
		end

		-- 🎯 حساب ارتفاع منطقة التمرير الإجمالية بالبكسل
		local totalCanvasHeight = #items * (buttonHeight + buttonSpacing)
		scroll_2.CanvasSize = UDim2.new(0, 0, 0, totalCanvasHeight)
	end
end)

local function getColor(char)
	local clr1,clr2=nil,nil
	if char.Parent==gameFolder then 
		clr1=Color3.fromRGB(0, 0, 255)
		clr2=Color3.fromRGB(0, 85, 255)
	else
		clr1=Color3.fromRGB(255, 0, 0)
		clr2=Color3.fromRGB(255, 44, 44)
	end
	return {clr1,clr2}
end

runService.Heartbeat:Connect(function()
	if upState then 
		local human = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
		if human then
			if tonumber(jumpBox.Text) then 
				human.UseJumpPower=true
				human.JumpPower=jumpBox.Text
			end
			if tonumber(speedBox.Text) then human.WalkSpeed=speedBox.Text end
		end
	end

	if EspTeddyState then 
		if gameFolder then 
			for _, enum in ipairs(gameFolder:GetChildren()) do 
				if enum:IsA("Folder") then 
					for _, fold in ipairs(enum:GetChildren()) do 
						if fold:IsA("Model") and fold:FindFirstChild("Humanoid") then 
							local isHold = false
							for _, item in ipairs(fold:GetChildren()) do 
								if item:IsA("Highlight") then 
									isHold = true 
									break
								end
							end
							if not isHold then 
								local color = getColor(fold)
								newOutline(fold, color[1], color[2])
							end
						end
					end
				end
			end
		end
	else
		-- عند إيقاف الـ ESP يتم إزالة الـ Highlight
		if gameFolder then 
			for _, enum in ipairs(gameFolder:GetChildren()) do 
				if enum:IsA("Folder") then 
					for _, fold in ipairs(enum:GetChildren()) do 
						if fold:IsA("Model") and (fold.Name == "Teddy" or fold:FindFirstChild("Humanoid")) then 
							for _, item in ipairs(fold:GetChildren()) do 
								if item:IsA("Highlight") then 
									item:Destroy()
								end
							end
						end
					end
				end
			end
		end    
	end
end)

runService.Heartbeat:Connect(function()
	if anitStuckState then 
		if gameFolder then 
			for _, item in ipairs(gameFolder:GetChildren()) do 
				if item:IsA("Model") and item.Name=="Honey" then 
					local hitbox = item:FindFirstChild("Hitbox")
					if hitbox then hitbox:Destroy() end
				end
			end
		end
	end
	
	if fullBrightnessState then 
		light.Brightness=3
		light.GlobalShadows=false
		light.Ambient=Color3.fromRGB(200, 200, 200)
	end
	
	if noClipState then 
		local char = LocalPlayer.Character
		if char then 
			for _, item in ipairs(char:GetChildren()) do 
				if item:IsA("BasePart") then item.CanCollide=false
				elseif item:IsA("Model") and char:FindFirstChild("BindableEventFreeze") then 
					for _, part in ipairs(item:GetChildren()) do 
						if part:IsA("BasePart") then part.CanCollide=false end
					end
				end
			end
		end
		
	end
end)

